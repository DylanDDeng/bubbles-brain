---
interface OutlineHeading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	headings: OutlineHeading[];
	locale: 'zh-CN' | 'en';
}

const { headings, locale } = Astro.props;
const isEnglish = locale === 'en';
---

<details class="article-outline" id="article-outline" data-article-outline open>
	<summary>
		<span>{isEnglish ? 'Contents' : '目录'}</span>
		<i class="ph ph-caret-down" aria-hidden="true"></i>
	</summary>
	<nav aria-label={isEnglish ? 'Contents' : '目录'}>
		<ol>
			{
				headings.map((heading) => (
					<li data-depth={heading.depth}>
						<a href={`#${heading.slug}`}>{heading.text}</a>
					</li>
				))
			}
		</ol>
	</nav>
</details>
{/* Phones: once the contents scroll away, a small pill shows the current section and leads back to them. */}
<a class="article-outline-float" href="#article-outline" data-outline-float hidden>
	<span>{isEnglish ? 'Contents' : '目录'}</span>
	<span data-outline-float-label></span>
</a>
