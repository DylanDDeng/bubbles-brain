---
import { benchmarkIcons } from '../lib/benchmarkIcons';
import {
	benchmarkLedger,
	benchmarkDirectoryRoute,
	benchmarkCategories,
	benchmarkParagraphs,
	collectNotes,
	formatScore,
	pick,
	rankedScores,
	type BenchmarkDefinition,
	type BenchmarkLocale,
} from '../lib/benchmarks';
import '../styles/benchmarks.css';

interface Props {
	benchmark: BenchmarkDefinition;
	locale: BenchmarkLocale;
}

const { benchmark, locale } = Astro.props;
const isEnglish = locale === 'en';
const rows = rankedScores(benchmark.id);
const notes = collectNotes(rows);
const noteIndex = new Map(notes.map((note, index) => [note.key, index + 1]));
const checkedAt = benchmark.checked_at ?? benchmarkLedger.checked_at;
const dateLabel = new Intl.DateTimeFormat(locale, {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
	timeZone: 'Asia/Shanghai',
}).format(new Date(`${checkedAt}T00:00:00+08:00`));
const showAgent = rows.some(({ score }) => score.agent);
const showAlmost = rows.some(({ score }) => score.almost_resolved !== undefined);
const showAllPass = rows.some(({ score }) => score.all_pass !== undefined);
const showCost = rows.some(({ score }) => score.average_cost_usd !== undefined);
const showDuration = rows.some(({ score }) => score.average_duration_seconds !== undefined);
const showResources = showCost || showDuration;
const costFormat = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
const showSecondary = showAlmost || showAllPass;
const secondaryLabel = showAllPass
	? isEnglish
		? 'All-Pass'
		: '全部通过'
	: isEnglish
		? 'Almost'
		: '接近解决';
const secondaryTooltip = showAllPass
	? isEnglish
		? 'Share of questions passing every check'
		: '所有评分检查均通过的题目比例'
	: isEnglish
		? 'Tasks passing at least 95% of tests; includes resolved tasks'
		: '至少通过 95% 测试的任务比例，包含完全解决的任务';
const paragraphs = benchmarkParagraphs(pick(benchmark.explainer, locale), locale);
const scoreReading = pick(benchmark.description, locale).replace(
	/^(?:分数怎么读：|How to read it:\s*)/,
	'',
);
---

<section class="page-shell bench-shell bench-detail">
	<header class="bench-header">
		<a class="collection-back" href={benchmarkDirectoryRoute(benchmark, locale)}>
			<i class="ph ph-arrow-left" aria-hidden="true"></i>
			Benchmarks
		</a>
		<p class="bench-domain bench-detail-domain">
			{
				pick(
					benchmarkCategories.find((category) => category.id === benchmark.category)!.name,
					locale,
				)
			}
		</p>
		<h1>{pick(benchmark.name, locale)}</h1>
		<p class="bench-lede">{pick(benchmark.measures, locale)}</p>
	</header>

	<section class="bench-guide" aria-labelledby="bench-guide-title">
		<h2 id="bench-guide-title" class="bench-section-title">
			{isEnglish ? 'What it measures' : '它测什么'}
		</h2>
		{paragraphs.map((paragraph) => <p class="bench-explainer">{paragraph}</p>)}
		<h2 class="bench-section-title">{isEnglish ? 'Reading the scores' : '怎么看分数'}</h2>
		<p class="bench-guide-reading">{scoreReading}</p>
		<p class="bench-guide-source">
			{isEnglish ? 'Source' : '来源'}
			<a href={benchmark.url} target="_blank" rel="noopener noreferrer">
				{benchmark.source}
				<i class="ph ph-arrow-up-right" aria-hidden="true"></i>
			</a>
		</p>
		{
			benchmark.related_reading && (
				<p class="bench-guide-source">
					<a href={pick(benchmark.related_reading.href, locale)}>
						{pick(benchmark.related_reading.title, locale)}
						<i class="ph ph-arrow-up-right" aria-hidden="true" />
					</a>
				</p>
			)
		}
	</section>

	<section class="bench-results" aria-labelledby="scores">
		<header class="bench-results-heading">
			<h2 class="bench-section-title" id="scores">
				{isEnglish ? 'Model performance' : '模型表现'}
			</h2>
			<p class="bench-meta">
				<span>{isEnglish ? 'Checked' : '核对于'} <time datetime={checkedAt}>{dateLabel}</time></span
				>
				<span>{rows.length} {isEnglish ? 'results' : '条成绩'}</span>
			</p>
		</header>

		<div
			class:list={['bench-table-wrap', { 'bench-table-wrap--resources': showResources }]}
			tabindex={showResources ? 0 : undefined}
			role={showResources ? 'region' : undefined}
			aria-label={showResources
				? isEnglish
					? 'Model performance, horizontally scrollable'
					: '模型表现表格，可横向滚动'
				: undefined}
		>
			<table
				class:list={[
					'bench-table',
					{ 'bench-table--with-almost': showSecondary, 'bench-table--resources': showResources },
				]}
				data-bench-table
			>
				<caption class="sr-only">
					{pick(benchmark.name, locale)} — {
						isEnglish
							? 'Model performance. Select a column heading to sort.'
							: '模型表现。选择列标题可排序。'
					}
				</caption>
				<thead>
					<tr>
						<th scope="col" class="bench-col-model">
							<button type="button" data-sort="name">{isEnglish ? 'Model' : '模型'}</button>
						</th>
						{
							showAgent && (
								<th scope="col" class="bench-col-agent">
									<button type="button" data-sort="agent">
										Agent
									</button>
								</th>
							)
						}
						<th scope="col" class="bench-col-score" aria-sort="descending">
							<button type="button" data-sort="score" data-numeric>
								{
									benchmark.score_label
										? pick(benchmark.score_label, locale)
										: showAlmost
											? isEnglish
												? 'Resolved'
												: '完全解决'
											: benchmark.format === 'percent'
												? isEnglish
													? 'Resolved'
													: '解决率'
												: isEnglish
													? 'Index'
													: '指数'
								}
							</button>
						</th>
						{
							showSecondary && (
								<th scope="col" class="bench-col-score">
									<button
										type="button"
										data-sort={showAllPass ? 'all-pass' : 'almost'}
										data-numeric
										title={secondaryTooltip}
									>
										{secondaryLabel}
									</button>
								</th>
							)
						}
						{
							showCost && (
								<th scope="col" class="bench-col-resource">
									<button
										type="button"
										data-sort="cost"
										data-numeric
										title={isEnglish ? 'Average cost per trial in USD' : '每次试验的平均费用，美元'}
									>
										{isEnglish ? 'Cost / trial' : '单次费用'}
									</button>
								</th>
							)
						}
						{
							showDuration && (
								<th scope="col" class="bench-col-resource">
									<button
										type="button"
										data-sort="duration"
										data-numeric
										title={
											isEnglish ? 'Average time per trial in hours' : '每次试验的平均耗时，小时'
										}
									>
										{isEnglish ? 'Time / trial' : '单次耗时'}
									</button>
								</th>
							)
						}
					</tr>
				</thead>
				<tbody>
					{
						rows.map(({ model, score }, rank) => {
							const noteNumber = noteIndex.get(model.id);
							const secondaryValue = showAllPass ? score.all_pass : score.almost_resolved;
							return (
								<tr
									data-name={model.name}
									data-creator={model.creator}
									data-agent={score.agent ?? ''}
									data-rank={rank}
								>
									<th scope="row">
										<div class="bench-model-identity">
											{benchmarkIcons[model.creator] ? (
												<img
													class="bench-model-icon"
													src={benchmarkIcons[model.creator]}
													width="18"
													height="18"
													alt=""
													aria-hidden="true"
												/>
											) : (
												<span class="bench-model-icon bench-model-initial" aria-hidden="true">
													{model.creator.charAt(0)}
												</span>
											)}
											<div class="bench-model-text">
												<span class="bench-model-name">{model.name}</span>
												<span class="bench-creator">{model.creator}</span>
												{score.agent && (
													<span class="bench-mobile-agent">Agent · {score.agent}</span>
												)}
											</div>
										</div>
									</th>
									{showAgent && <td class="bench-agent-cell">{score.agent ?? '—'}</td>}
									<td class="bench-score" data-value={score.value}>
										<span class="bench-result">
											<span class="bench-value">{formatScore(score, benchmark.format)}</span>
											{noteNumber && (
												<a
													class="bench-note-ref"
													href={`#bench-note-${noteNumber}`}
													id={`bench-ref-${noteNumber}`}
													aria-label={isEnglish ? `Note ${noteNumber}` : `注释 ${noteNumber}`}
												>
													<sup>{noteNumber}</sup>
												</a>
											)}
										</span>
										{score.ci !== undefined && (
											<span
												class="bench-ci"
												aria-label={
													isEnglish
														? `95% confidence interval: plus or minus ${score.ci}${benchmark.format === 'percent' ? ' percentage points' : ''}`
														: `95% 置信区间：正负 ${score.ci}${benchmark.format === 'percent' ? ' 个百分点' : ''}`
												}
											>
												± {score.ci}
											</span>
										)}
										{score.worst_at_5 !== undefined && score.best_at_5 !== undefined && (
											<span
												class="bench-trial-range"
												title={
													isEnglish
														? 'Worst@5–best@5; not a confidence interval'
														: 'Worst@5–best@5；不是置信区间'
												}
											>
												<span>
													{score.worst_at_5.toFixed(1)}–{score.best_at_5.toFixed(1)}%
												</span>
												<span>worst–best@5</span>
											</span>
										)}
									</td>
									{showSecondary && (
										<td class="bench-score" data-value={secondaryValue}>
											<span class="bench-value">
												{secondaryValue === undefined ? '—' : `${secondaryValue.toFixed(1)}%`}
											</span>
										</td>
									)}
									{showCost && (
										<td class="bench-score bench-resource" data-value={score.average_cost_usd}>
											{score.average_cost_usd === undefined
												? '—'
												: costFormat.format(score.average_cost_usd)}
										</td>
									)}
									{showDuration && (
										<td
											class="bench-score bench-resource"
											data-value={score.average_duration_seconds}
										>
											{score.average_duration_seconds === undefined
												? '—'
												: `${(score.average_duration_seconds / 3600).toFixed(1)} ${isEnglish ? 'h' : '小时'}`}
										</td>
									)}
								</tr>
							);
						})
					}
				</tbody>
			</table>
		</div>

		{
			notes.length > 0 && (
				<footer class="bench-footer">
					<ol class="bench-notes">
						{notes.map((note, index) => (
							<li id={`bench-note-${index + 1}`}>
								{pick(note.score.note!, locale)}
								{note.score.note_url && (
									<a href={note.score.note_url} target="_blank" rel="noopener noreferrer">
										{isEnglish ? 'source' : '来源'}
										<i class="ph ph-arrow-up-right" aria-hidden="true" />
									</a>
								)}
								<a
									href={`#bench-ref-${index + 1}`}
									class="bench-note-back"
									aria-label={isEnglish ? 'Back to table' : '返回表格'}
								>
									↩
								</a>
							</li>
						))}
					</ol>
				</footer>
			)
		}
	</section>
</section>

<script>
	import '../scripts/benchmarkSort';
</script>
