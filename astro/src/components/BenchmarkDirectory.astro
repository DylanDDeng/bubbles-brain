---
import { benchmarkRoute, groupedBenchmarks, pick, type BenchmarkLocale } from '../lib/benchmarks';
import '../styles/brainpodCollection.css';
import '../styles/benchmarks.css';

interface Props {
	locale: BenchmarkLocale;
	embedded?: boolean;
}
const { locale, embedded = false } = Astro.props;
const groups = groupedBenchmarks();
---

<div
	class:list={['bench-directory', { 'bench-standalone-directory': !embedded }]}
	data-benchmark-standalone={!embedded || undefined}
>
	<div
		id={embedded ? undefined : 'bc-benchmarks'}
		data-room-subview={embedded ? 'benchmarks' : undefined}
		data-benchmark-view="benchmarks"
	>
		{
			embedded && (
				<header class="bc-panel-heading">
					<h2 id="bc-title-benchmarks" tabindex="-1">
						Benchmarks
					</h2>
				</header>
			)
		}
		<ul class="bc-tracks bc-subsections">
			{
				groups.map((group) => (
					<li>
						<a href={`#bc-benchmarks-${group.id}`} data-room-pick={`benchmarks-${group.id}`}>
							<span>{pick(group.name, locale)}</span>
							<i class="ph ph-arrow-right" aria-hidden="true" />
						</a>
					</li>
				))
			}
		</ul>
	</div>
	{
		groups.map((group) => (
			<section
				id={`bc-benchmarks-${group.id}`}
				data-room-subview={embedded ? `benchmarks-${group.id}` : undefined}
				data-benchmark-view={`benchmarks-${group.id}`}
				aria-labelledby={`bc-title-benchmarks-${group.id}`}
			>
				<a class="bc-parent-link" href="#bc-benchmarks" data-room-pick="benchmarks">
					<i class="ph ph-arrow-left" aria-hidden="true" />
					Benchmarks
				</a>
				<header class="bc-panel-heading">
					<h2 id={`bc-title-benchmarks-${group.id}`} tabindex="-1">
						{pick(group.name, locale)}
					</h2>
				</header>
				<ul class="bc-tracks">
					{group.benchmarks.map((benchmark) => (
						<li>
							<a href={benchmarkRoute(benchmark.id, locale)}>
								<span>
									{pick(benchmark.name, locale)}
									<span
										class="reading-update-dot"
										data-update-item={benchmarkRoute(benchmark.id, locale)}
										role="img"
										aria-label={locale === 'en' ? 'Unread update' : '未读更新'}
										hidden
									/>
								</span>
								<i class="ph ph-arrow-up-right" aria-hidden="true" />
							</a>
						</li>
					))}
				</ul>
			</section>
		))
	}
</div>

<script>
	import '../scripts/benchmarkDirectory';
</script>
