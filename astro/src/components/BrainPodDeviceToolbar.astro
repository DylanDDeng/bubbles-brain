<div class="device-toolbar">
	<p class="controls-hint">转动滚轮，换个脑回路。</p>
	<details class="device-settings" id="device-settings">
		<summary aria-label="播放器设置" title="播放器设置"
			><i class="ph ph-sliders-horizontal" aria-hidden="true"></i></summary
		>
		<div class="settings-panel">
			<div class="finish-setting">
				<span>外观</span><div class="swatches" aria-label="机身颜色">
					<button
						class="configurator-chip"
						data-finish="white"
						aria-label="月光白"
						aria-pressed="true"></button>
					<button
						class="configurator-chip"
						data-finish="graphite"
						aria-label="石墨黑"
						aria-pressed="false"></button>
				</div>
			</div>
			<button class="utility" id="turn-device" aria-label="翻转 iPod"
				><i class="ph ph-arrow-counter-clockwise" aria-hidden="true"></i><span>翻转</span></button
			>
			<button class="utility" id="sound-toggle" aria-pressed="false"
				><i class="ph ph-speaker-slash" aria-hidden="true"></i><span>声音关</span></button
			>
			<button class="utility" id="poster-motion-toggle" type="button" aria-pressed="true" aria-label="暂停画面动效" hidden
				><i class="ph ph-pause" aria-hidden="true"></i><span>暂停动效</span></button
			>
			<p class="keyboard-hint">↑ ↓ 选择 · Enter 进入<br />MENU / Esc 返回上一级</p>
		</div>
	</details>
</div>
