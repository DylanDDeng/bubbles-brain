---
import { buildBrainPodTerms } from '../lib/brainpodTerms';
import BrainPodCollectionParentLink from './BrainPodCollectionParentLink.astro';
const categories = buildBrainPodTerms();
---

<div class="bc-term-directory">
	<div data-room-subview="vibe-coding-terms">
		<BrainPodCollectionParentLink collection="vibe-coding-terms" />
		<header class="bc-panel-heading">
			<h2 id="bc-title-vibe-coding-terms" tabindex="-1">术语</h2>
		</header>
		<ul class="bc-tracks bc-term-categories">
			{
				categories.map((category) => (
					<li>
						<a href={'#bc-' + category.pages[0].id} data-room-pick={category.pages[0].id}>
							<>
								<span>
									{category.label}
									<span
										class="reading-update-dot"
										data-update-items={category.pages
											.flatMap((page) => page.terms.map((term) => `/vibe-coding/terms/${term.id}/`))
											.join(' ')}
										role="img"
										aria-label="有未读更新"
										hidden
									/>
								</span>
								<i class="ph ph-arrow-right" aria-hidden="true" />
							</>
						</a>
					</li>
				))
			}
		</ul>
	</div>
	{
		categories.flatMap((category) =>
			category.pages.map((page, index) => (
				<section
					id={'bc-' + page.id}
					data-room-subview={page.id}
					aria-labelledby={'bc-title-' + page.id}
				>
					<a class="bc-parent-link" href="#bc-vibe-coding-terms" data-room-pick="vibe-coding-terms">
						<i class="ph ph-arrow-left" aria-hidden="true" />
						术语
					</a>
					<header class="bc-panel-heading">
						<h2 id={'bc-title-' + page.id} tabindex="-1">
							{category.label}
						</h2>
					</header>
					{page.group && <p class="bc-term-group">{page.group}</p>}
					<ul class="bc-tracks">
						{page.terms.map((term) => (
							<li>
								<a href={`/vibe-coding/terms/${term.id}/`}>
									<span>
										{term.chineseName}
										{term.chineseName !== term.name && `（${term.name}）`}
										<span
											class="reading-update-dot"
											data-update-item={`/vibe-coding/terms/${term.id}/`}
											role="img"
											aria-label="未读更新"
											hidden
										/>
									</span>
									<i class="ph ph-arrow-up-right" aria-hidden="true" />
								</a>
							</li>
						))}
					</ul>
					{category.pages.length > 1 && (
						<nav class="bc-term-pagination" aria-label={`${category.label}翻页`}>
							{index > 0 ? (
								<a
									href={'#bc-' + category.pages[index - 1].id}
									data-room-pick={category.pages[index - 1].id}
								>
									<i class="ph ph-arrow-left" aria-hidden="true" />
									上一页
									<span
										class="reading-update-dot"
										data-update-items={category.pages
											.slice(0, index)
											.flatMap((page) => page.terms.map((term) => `/vibe-coding/terms/${term.id}/`))
											.join(' ')}
										role="img"
										aria-label="前面的页面有未读更新"
										hidden
									/>
								</a>
							) : (
								<span />
							)}
							<span
								class="bc-term-page-number"
								aria-label={`第 ${index + 1} 页，共 ${category.pages.length} 页`}
							>
								{index + 1} / {category.pages.length}
							</span>
							{index < category.pages.length - 1 ? (
								<a
									href={'#bc-' + category.pages[index + 1].id}
									data-room-pick={category.pages[index + 1].id}
								>
									下一页
									<span
										class="reading-update-dot"
										data-update-items={category.pages
											.slice(index + 1)
											.flatMap((page) => page.terms.map((term) => `/vibe-coding/terms/${term.id}/`))
											.join(' ')}
										role="img"
										aria-label="后面的页面有未读更新"
										hidden
									/>
									<i class="ph ph-arrow-right" aria-hidden="true" />
								</a>
							) : (
								<span />
							)}
						</nav>
					)}
				</section>
			)),
		)
	}
</div>
