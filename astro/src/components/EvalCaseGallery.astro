---
import {
	cardVendors,
	evalLedger,
	evalModel,
	evalTaskCards,
	evalTaskRoute,
	evalThumb,
	evalYears,
	modelCount,
	shortDate,
} from '../lib/evalCases';
import EvalVendorPile from './EvalVendorPile.astro';
import BenchmarksHead from './BenchmarksHead.astro';
import '../styles/eval-cases.css';

const cards = evalTaskCards();
const years = evalYears();
const { tasks, cases, categories } = evalLedger;
const usedModels = [...new Set(cases.map((item) => item.model))]
	.map(evalModel)
	.sort((a, b) => a.vendor.localeCompare(b.vendor) || a.name.localeCompare(b.name));
const usedCategories = categories
	.map((category) => ({
		...category,
		count: tasks.filter((task) => task.category === category.id).length,
	}))
	.filter((category) => category.count > 0);
---

<section class="page-shell eval-shell eval-gallery" data-eval-gallery>
	<BenchmarksHead current="cases" class="eval-head" />

	<div class="eval-toolbar" data-eval-filters hidden>
		<label class="rr-search eval-search">
			<i class="ph ph-magnifying-glass" aria-hidden="true"></i>
			<span class="sr-only">搜索题目或模型</span>
			<input type="search" placeholder="搜题目或模型，比如 Opus 5.5" autocomplete="off" data-eval-search />
		</label>
		<div class="rr-filters eval-types" role="group" aria-label="题目类型">
			<button type="button" data-filter-category="" aria-pressed="true">全部</button>
			{
				usedCategories.map((category) => (
					<button type="button" data-filter-category={category.id} aria-pressed="false">
						{category.name.zh}
					</button>
				))
			}
		</div>
		<div class="eval-toolbar-end">
			<label class="eval-menu">
				<span class="sr-only">模型</span>
				<i class="ph ph-cube" aria-hidden="true"></i>
				<select data-filter-model>
					<option value="">全部模型</option>
					{
						usedModels.map((model) => (
							<option value={model.id}>
								{model.name} · {model.vendor}
							</option>
						))
					}
				</select>
			</label>
			<label class="eval-menu">
				<span class="sr-only">模型发布年份</span>
				<i class="ph ph-calendar-blank" aria-hidden="true"></i>
				<select data-filter-year>
					<option value="">全部年份</option>
					{years.map((year) => <option value={year}>{year} 年模型</option>)}
				</select>
			</label>
			<label class="eval-menu">
				<span class="sr-only">排序</span>
				<i class="ph ph-sort-descending" aria-hidden="true"></i>
				<select data-sort>
					<option value="recent">最近更新</option>
					<option value="models">模型最多</option>
				</select>
			</label>
			<div class="eval-view" role="group" aria-label="视图">
				<button type="button" data-view="grid" aria-pressed="true" title="网格视图">
					<i class="ph ph-squares-four" aria-hidden="true"></i>
					<span class="sr-only">网格视图</span>
				</button>
				<button type="button" data-view="list" aria-pressed="false" title="列表视图">
					<i class="ph ph-list" aria-hidden="true"></i>
					<span class="sr-only">列表视图</span>
				</button>
			</div>
		</div>
	</div>

	<ul class="eval-grid" data-eval-grid data-view="grid">
		{
			cards.map((card, index) => {
				const cover = card.cases[0];
				const models = modelCount(card.cases);
				return (
					<li
						class="eval-card"
						data-category={card.task.category}
						data-models={card.cases.map((item) => item.model).join(' ')}
						data-years={card.years.join(' ')}
						data-latest={cover.date}
						data-count={models}
						data-order={index}
						data-search={[card.task.title.zh, ...card.cases.map((item) => evalModel(item.model).name)]
							.join(' ')
							.toLocaleLowerCase()}
					>
						<a href={evalTaskRoute(card.task.id)}>
							<span class="eval-thumb">
								<img
									src={evalThumb(cover.id)}
									alt=""
									width="640"
									height="400"
									loading={index < 6 ? 'eager' : 'lazy'}
									decoding="async"
								/>
							</span>
							<span class="eval-card-body">
								<span class="eval-card-title">
									{card.task.title.zh}
									<span class="eval-new" data-eval-new hidden>
										新
									</span>
								</span>
								<span class="eval-card-meta">
									<EvalVendorPile vendors={cardVendors(card.cases)} />
									<span class="eval-card-count">{models > 1 ? `${models} 个模型` : '单模型'}</span>
									<time datetime={cover.date}>{shortDate(cover.date)}</time>
								</span>
							</span>
						</a>
					</li>
				);
			})
		}
	</ul>

	<button type="button" class="rr-more-icon" data-eval-more aria-label="展开更多题目" hidden>
		<svg
			width="20"
			height="20"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="1.8"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg
		>
	</button>
	<p class="eval-empty" data-eval-empty hidden>没有符合筛选条件的案例。</p>
</section>

<script>
	import '../scripts/evalCases';
</script>
