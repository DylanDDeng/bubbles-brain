---
interface Props {
	locale?: 'zh-CN' | 'en';
}
const { locale = 'zh-CN' } = Astro.props;
const isEnglish = locale === 'en';
---

<nav aria-label={isEnglish ? 'Footer' : '页脚'}>
	<a href="/changelog/">{isEnglish ? 'Updates' : '更新日志'}</a>
	<a href={isEnglish ? '/en/about/' : '/about/'}>{isEnglish ? 'About' : '关于'}</a>
	<a href={isEnglish ? '/en/rss.xml' : '/rss.xml'}>RSS</a>
	<a href="https://github.com/DylanDDeng/bubbles-brain" target="_blank" rel="noopener noreferrer"
		>GitHub</a
	>
	<a href={isEnglish ? '/' : '/en/'}>{isEnglish ? '中文' : 'English'}</a>
</nav>
<p>{isEnglish ? "© 2026 Bubble's Brain · Kept by a cat" : "© 2026 Bubble's Brain · 由一只猫看管"}</p>
