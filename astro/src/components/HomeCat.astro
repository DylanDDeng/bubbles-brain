---
import { buildBrainPodLibrary } from '../lib/brainpod';
import { buildKnowledgeSearchIndex } from '../lib/searchIndex';
import { showcaseByNewest, showcaseHref } from '../data/showcase';
import { siteSections } from '../lib/siteSections';
import { vibeCodingTermCategories } from '../data/vibeCodingTerms';
import '../styles/home.css';

const library = buildBrainPodLibrary(await buildKnowledgeSearchIndex({ locale: 'zh-CN' }));
const count = (...ids: string[]) =>
	ids.reduce(
		(sum, id) => sum + (library.collections.find((c) => c.id === id)?.items.length ?? 0),
		0,
	);
const counts: Record<string, number> = {
	tutorials: count('newbie-tutorials', 'codex-tutorials', 'pi-agent-tutorials', 'workbuddy-tutorials'),
	highlights: count('highlights'),
	// Terms are counted one per word, leaving out the category pages the collection also holds.
	'vibe-coding':
		vibeCodingTermCategories.reduce((sum, category) => sum + category.terms.length, 0) +
		count('vibe-coding-skills', 'vibe-coding-design', 'vibe-coding-showcase'),
	benchmarks: count('benchmarks'),
};
const sections = siteSections('zh-CN').map((section) => ({
	...section,
	count: counts[section.id],
}));

// The newest two things, whatever section they came from.
const featured = showcaseByNewest()[0];
const recent = [
	...(featured ? [{ title: featured.title, href: showcaseHref(featured), date: featured.added }] : []),
	...library.recent.map(({ item, recordedAt }) => ({
		title: item.title,
		href: item.href,
		date: recordedAt,
	})),
]
	.sort((a, b) => b.date.localeCompare(a.date))
	.filter((item, index, all) => all.findIndex((other) => other.href === item.href) === index)
	.slice(0, 2);
---

<div class="home">
	<img
		class="home-cat"
		src="/images/cat-pose-3.jpg"
		alt="站着的猫馆长，铅笔插画"
		width="1100"
		height="765"
	/>
	<h1 class="home-title">Bubble's Brain</h1>
	<form class="home-search" action="/search/" method="get" role="search">
		<i class="ph ph-magnifying-glass" aria-hidden="true"></i>
		<label class="sr-only" for="home-query">搜索知识库</label>
		<input
			id="home-query"
			name="q"
			type="search"
			autocomplete="off"
			placeholder="想弄懂什么？比如：上下文窗口"
		/>
	</form>
	<nav class="home-sections" aria-label="栏目">
		{
			sections.map((section) => (
				<a href={section.href}>
					{section.label}
					{section.count !== undefined && <span>{section.count}</span>}
				</a>
			))
		}
	</nav>
	{
		recent.length > 0 && (
			<p class="home-recent">
				最近：
				{recent.map((item, index) => (
					<>
						{index > 0 && ' · '}
						<a href={item.href}>{item.title}</a>
					</>
				))}
			</p>
		)
	}
</div>

<script>
	import '../scripts/homeRedirects';
</script>
