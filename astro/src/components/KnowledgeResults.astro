---
import type { KnowledgeSearchItem } from '../lib/searchIndex';

interface Props {
	items: KnowledgeSearchItem[];
	filterable?: boolean;
}

const { items, filterable = false } = Astro.props;
---

{/* Each result is its section and title; the summary still counts for the search. */}
<ol class="rr-rows rr-rows--plain knowledge-results" data-knowledge-results>
	{
		items.map((item) => (
			<li
				data-knowledge-search-item={filterable ? '' : undefined}
				data-section={filterable ? item.section : undefined}
				data-search={filterable ? item.search_text : undefined}
			>
				<a
					class="knowledge-result"
					href={item.href}
					target={item.external ? '_blank' : undefined}
					rel={item.external ? 'noopener noreferrer' : undefined}
				>
					<span class="knowledge-result__meta">{item.section_label}</span>
					<span class="knowledge-result__title">
						{item.title}
						{item.external && ' ↗'}
					</span>
				</a>
			</li>
		))
	}
</ol>
