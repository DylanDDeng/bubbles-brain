---
import SourceMark from './SourceMark.astro';
import {
	formatShowcaseDuration,
	showcaseByNewest,
	showcaseHref,
	type ShowcaseWork,
} from '../data/showcase';
import { showcaseMediaUrl } from '../lib/showcaseMedia';
import { sourceMark } from '../lib/sourceVendor';
import '../styles/showcase.css';
import '../styles/showcase-work.css';

interface Props {
	work: ShowcaseWork;
}

// One work, laid out like an article: the way back at the left edge, the film in the
// middle, and a narrow text column under it.
const { work } = Astro.props;
const works = showcaseByNewest();
const next = works[works.indexOf(work) + 1];
const prompt = work.prompt;
const movements = work.movements?.length ? work.movements : undefined;
const promptLangs = (['zh', 'en'] as const).filter((lang) => prompt?.[lang]);
// Section tags such as <inputs> in a structured prompt are set quieter than the instructions.
const promptLines = (text: string) =>
	text.split('\n').map((line) => ({ line, tag: /^<\/?[\w-]+>$/.test(line.trim()) }));
---

<article class="work-page">
	<div class="work-rail">
		<a class="work-back" href="/vibe-coding/showcase/">← Showcase</a>
	</div>

	<figure class:list={['work-screen', { 'work-screen--tall': work.height / work.width > 0.8 }]}>
		<video
			src={showcaseMediaUrl(work.video)}
			poster={showcaseMediaUrl(work.poster)}
			width={work.width}
			height={work.height}
			controls
			playsinline
			preload="metadata"
			aria-label={movements
				? `${work.title} · ${movements[0]!.numeral}. ${movements[0]!.title}`
				: work.title}
			data-showcase-video></video>
	</figure>

	<div class="work-text">
		<p class="work-kicker">{formatShowcaseDuration(work.duration)}</p>
		<h1>{work.title}</h1>
		<p class="work-note">{work.note}</p>
		{
			movements && (
				<section class="work-movements" aria-labelledby={`work-movements-${work.id}`}>
					<h2 id={`work-movements-${work.id}`}>乐章</h2>
					{/* Without JavaScript each row opens its file; scripts/showcase.ts plays it in place. */}
					<ol data-showcase-movements>
						{movements.map((movement, i) => (
							<li>
								<a
									class="work-movement"
									href={showcaseMediaUrl(movement.video)}
									aria-current={i === 0 ? 'true' : undefined}
									data-movement-video={showcaseMediaUrl(movement.video)}
									data-movement-poster={showcaseMediaUrl(movement.poster)}
									data-movement-label={`${work.title} · ${movement.numeral}. ${movement.title}`}
								>
									<img
										src={showcaseMediaUrl(movement.poster)}
										alt=""
										width="44"
										height="44"
										loading="lazy"
										decoding="async"
									/>
									<span class="work-movement__name">
										<span class="work-movement__numeral">{movement.numeral}.</span>
										<span lang="en">{movement.title}</span>
										{movement.titleZh && <span class="work-movement__zh">{movement.titleZh}</span>}
									</span>
									<span class="work-movement__time">
										{formatShowcaseDuration(movement.duration)}
									</span>
								</a>
							</li>
						))}
					</ol>
				</section>
			)
		}
		{
			work.source && (
				<p class="work-source">
					<span class="work-source__who">
						<SourceMark mark={sourceMark(work.source.author, work.source.url)} size={16} />
						{work.source.author}
					</span>
					<a href={work.source.url} target="_blank" rel="noopener noreferrer">
						看原帖 ↗
					</a>
				</p>
			)
		}

		{
			prompt && promptLangs.length > 0 && (
				<section
					class="showcase-prompt work-prompt"
					aria-labelledby={`work-prompt-${work.id}`}
					data-showcase-prompt
				>
					<div class="showcase-prompt-head">
						<h2 id={`work-prompt-${work.id}`}>提示词</h2>
						<div class="showcase-prompt-tools" data-prompt-tools hidden>
							{promptLangs.length > 1 && (
								<div class="showcase-prompt-langs" role="group" aria-label="提示词语言">
									{promptLangs.map((lang, i) => (
										<button
											type="button"
											data-prompt-lang={lang}
											aria-pressed={i === 0 ? 'true' : 'false'}
										>
											{lang === 'zh' ? '中' : 'EN'}
										</button>
									))}
								</div>
							)}
							<button type="button" class="showcase-link-button" data-prompt-copy>
								复制
							</button>
						</div>
					</div>
					{promptLangs.map((lang, i) => (
						<p
							class="showcase-prompt-text"
							lang={lang === 'zh' ? 'zh-CN' : 'en'}
							data-prompt-text={lang}
							hidden={i > 0}
						>
							{promptLines(prompt[lang]!).map(({ line, tag }, j, all) => (
								<Fragment>
									{tag ? <span class="showcase-prompt-tag">{line}</span> : line}
									{j < all.length - 1 ? '\n' : ''}
								</Fragment>
							))}
						</p>
					))}
					<button
						type="button"
						class="showcase-link-button"
						data-prompt-toggle
						aria-expanded="false"
						hidden
					>
						展开全部
					</button>
				</section>
			)
		}

		<nav class="work-pager" aria-label="上一部与下一部">
			<a href="/vibe-coding/showcase/">
				<span>← 回到</span>
				<strong>Showcase</strong>
			</a>
			{
				next && (
					<a class="work-pager__next" href={showcaseHref(next)} data-astro-prefetch="false">
						<span>下一部 →</span>
						<strong>{next.title}</strong>
					</a>
				)
			}
		</nav>
	</div>
</article>

<script>
	import '../scripts/showcase';
</script>
