---
import AuthControls from './AuthControls.astro';

interface Props {
	locale: 'zh-CN' | 'en';
	languageHref: string;
	/** On the home page the header is only these quiet links, so 更新日志 and 关于 join them. */
	home?: boolean;
}

const { locale, languageHref, home = false } = Astro.props;
const isEnglish = locale === 'en';
---

<div class="site-actions">
	{
		home && (
			<>
				<a href="/changelog/">{isEnglish ? 'Updates' : '更新日志'}</a>
				<a href={isEnglish ? '/en/about/' : '/about/'}>{isEnglish ? 'About' : '关于'}</a>
			</>
		)
	}
	<a href={languageHref} aria-label={isEnglish ? '切换到中文' : 'Switch to English'}>
		{isEnglish ? '中文' : 'EN'}
	</a>
	<AuthControls locale={locale} inline />
</div>
