										? 'true'
										: 'false'
								}
							>
								<b>{preset.label}</b>
								<small>{preset.note}</small>
							</button>
						))}
					</div>
				)
			}

			<div class="motion-controls">
				{
					profile.controls.map((control) =>
						control.type === 'range' ? (
							<label class="motion-control" data-motion-control={control.id}>
								<span class="motion-control__label">{control.label}</span>
								<input
									type="range"
									min={control.min}
									max={control.max}
									step={control.step}
									value={control.value}
									data-motion-input={control.id}
								/>
								<output data-motion-output={control.id}>
									{formatMotionValue(control, control.value)}
								</output>
							</label>
						) : (
							<div class="motion-control" data-motion-control={control.id}>
								<span class="motion-control__label">{control.label}</span>
								<div class="motion-choices" role="group" aria-label={control.label}>
									{control.options!.map((option) => (
										<button
											type="button"
											data-motion-choice={control.id}
											data-value={option.value}
											aria-pressed={option.value === control.value ? 'true' : 'false'}
										>
											{option.label}
										</button>
									))}
								</div>
							</div>
						),
					)
				}
			</div>

			<div class="motion-prompt">
				<div class="motion-prompt__head">
					<h2 class="motion-prompt__title" id="motion-prompt-title">跟 AI 这么说</h2>
					<button type="button" data-motion-copy>
						<i class="ph ph-copy" aria-hidden="true"></i>
						<span data-motion-copy-label>复制</span>
					</button>
				</div>
				<p data-motion-prompt aria-live="polite">
					{renderMotionPrompt(profile, defaults)}
				</p>
			</div>
			{
				usedOn.length > 0 && (
					<p class="motion-used-on">
						常用在
						{usedOn.map((pattern) => (
							<a href={`/vibe-coding/terms/${pattern.id}/`}>{pattern.chineseName}</a>
						))}
					</p>
				)
			}
		</section>

		<section class="term-section" aria-labelledby="concept-boundary-title">
			<h2 class="term-section__title" id="concept-boundary-title">最容易踩的坑</h2>
			<p class="term-section__intro">{profile.warning}</p>
		</section>

		<footer class="article-ending">
			<nav class="article-pagination" aria-label="相邻术语">
				{
					previousConcept && (
						<a
							href={`/vibe-coding/terms/${previousConcept.id}/`}
							class="article-previous"
							rel="prev"
						>
							<span>← 上一个</span>
							<strong class="article-pagination-title">{previousConcept.chineseName}</strong>
						</a>
					)
				}
				{
					nextConcept && (
						<a href={`/vibe-coding/terms/${nextConcept.id}/`} class="article-next" rel="next">
							<span>下一个 →</span>
							<strong class="article-pagination-title">{nextConcept.chineseName}</strong>
						</a>
					)
				}
			</nav>
		</footer>
	</div>
</article>

<script>
	import '../scripts/article-outline.ts';
	import '../scripts/motionTuner.ts';
</script>
