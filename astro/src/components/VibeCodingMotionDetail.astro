---
import { vibeCodingTermCategories, type VibeCodingConcept } from '../data/vibeCodingTerms';
import { brainPodTermReturn } from '../lib/brainpodTerms';
import {
	defaultMotionValues,
	formatMotionValue,
	patternsForMotion,
	renderMotionPrompt,
	type MotionProfile,
} from '../lib/vibeCodingMotion';
import ArticleOutline from './ArticleOutline.astro';
import '../styles/reading-page.css';
import '../styles/term-page.css';
import '../styles/vibe-coding-motion.css';

interface Props {
	concept: VibeCodingConcept;
	profile: MotionProfile;
	previousConcept: VibeCodingConcept | null;
	nextConcept: VibeCodingConcept | null;
}

const { concept, profile, previousConcept, nextConcept } = Astro.props;
// Motion is read by watching it: the stage leads, text stays to one line and one warning.
const outline = [
	{ slug: 'motion-stage-title', text: '亲手调一调' },
	{ slug: 'motion-prompt-title', text: '跟 AI 这么说' },
	{ slug: 'concept-boundary-title', text: '最容易踩的坑' },
].map((heading) => ({ ...heading, depth: 2 }));
const demo = profile.demo;
// 这个动效常用在界面图鉴的哪些零件上
const patternTerms =
	vibeCodingTermCategories.find((category) => category.id === 'ui-patterns')?.terms ?? [];
const usedOn = patternsForMotion(concept.id)
	.map((id) => patternTerms.find((term) => term.id === id))
	.filter((term) => term !== undefined);
const pointerDemo = [
	'lift',
	'press',
	'magnetic',
	'spotlight',
	'tilt',
	'ripple',
	'like',
	'toggle',
	'loading',
	'shake',
	'focus',
	'copy',
	'cart',
	'expand',
	'pageTransition',
	'sharedElement',
	'drag',
	'swipe',
	'pull',
	'modal',
	'drawer',
	'toast',
	'dropdown',
	'tooltip',
	'confetti',
].includes(demo);
const defaults = defaultMotionValues(profile);
// 演示用的真实内容：一个虚构的笔记 App「小记」，和一个徒步路线网站
const features = [
	{ icon: 'ph-microphone', tone: 'blue', title: '语音速记', text: '说一句话，自动转成文字' },
	{ icon: 'ph-image', tone: 'amber', title: '图片识字', text: '拍下白板，文字一键提取' },
	{ icon: 'ph-arrows-clockwise', tone: 'green', title: '多端同步', text: '手机上写，电脑上接着改' },
	{
		icon: 'ph-magnifying-glass',
		tone: 'violet',
		title: '全文搜索',
		text: '三年前的一句话也能找到',
	},
	{ icon: 'ph-lock-key', tone: 'red', title: '本地加密', text: '只有你能看到你的笔记' },
	{ icon: 'ph-tag', tone: 'teal', title: '自动标签', text: '不用手动整理，自动归类' },
];
const templates = [
	{ icon: 'ph-chart-line-up', tone: 'blue', title: '周报', uses: '2.1 万人在用' },
	{ icon: 'ph-book-open', tone: 'amber', title: '读书笔记', uses: '1.8 万人在用' },
	{ icon: 'ph-airplane-tilt', tone: 'teal', title: '旅行清单', uses: '9,320 人在用' },
	{ icon: 'ph-users-three', tone: 'violet', title: '会议纪要', uses: '1.5 万人在用' },
	{ icon: 'ph-barbell', tone: 'red', title: '健身记录', uses: '6,410 人在用' },
	{ icon: 'ph-cooking-pot', tone: 'amber', title: '菜谱', uses: '7,880 人在用' },
	{ icon: 'ph-check-square', tone: 'green', title: '待办', uses: '3.2 万人在用' },
	{ icon: 'ph-moon-stars', tone: 'blue', title: '日记', uses: '2.6 万人在用' },
];
const storySteps = [
	{
		title: '随手记',
		text: '想到什么，打开就写，不用先想放在哪个文件夹。',
		screen: '快速记录',
		icon: 'ph-pencil-simple-line',
		tone: 'blue',
	},
	{
		title: '自动整理',
		text: '小记会读懂你写的内容，自动打上标签、归好类。',
		screen: '自动标签',
		icon: 'ph-tag',
		tone: 'teal',
	},
	{
		title: '随时找回',
		text: '三年前的一句话，搜一个词就能找到。',
		screen: '全文搜索',
		icon: 'ph-magnifying-glass',
		tone: 'violet',
	},
];
const headline = [
	['每一个', '想法，'],
	['都值得', '被记住'],
];
const partners = [
	{ icon: 'ph-coffee', name: '山野咖啡' },
	{ icon: 'ph-books', name: '云端书店' },
	{ icon: 'ph-pen-nib', name: '小满设计' },
	{ icon: 'ph-graduation-cap', name: '橙子学堂' },
	{ icon: 'ph-sun-horizon', name: '晨光出版' },
	{ icon: 'ph-star-four', name: '北极星科技' },
];
const changelog = [
	'语音速记支持方言：粤语、四川话、东北话',
	'图片识字准确率提升 30%，手写体也能认',
	'新增「读书笔记」「会议纪要」两个模板',
	'夜间模式更柔和，看久了不累眼',
	'修复：iPad 分屏时偶尔无法同步的问题',
];
const notes = [
	{ icon: 'ph-chart-line-up', tone: 'blue', title: '第 41 周周报', meta: '工作 · 今天 09:30' },
	{ icon: 'ph-book-open', tone: 'amber', title: '《置身事内》读书笔记', meta: '读书 · 昨天' },
	{ icon: 'ph-airplane-tilt', tone: 'teal', title: '国庆去大理', meta: '旅行 · 9 月 28 日' },
];
const todos = ['回复设计稿的修改意见', '整理用户访谈记录', '写第 41 周周报', '预约周六的体检'];
const messages = [
	{ icon: 'ph-heart', tone: 'red', title: '阿青赞了你的笔记', text: '《置身事内》读书笔记' },
	{ icon: 'ph-chat-circle', tone: 'blue', title: '小满评论了你', text: '这个模板好用，求分享！' },
	{ icon: 'ph-gift', tone: 'amber', title: '你获得了 1 个月 Pro', text: '感谢邀请朋友加入小记' },
];
const toolbar = [
	{ icon: 'ph-text-b', tip: '加粗 ⌘B' },
	{ icon: 'ph-text-italic', tip: '斜体 ⌘I' },
	{ icon: 'ph-link', tip: '插入链接 ⌘K' },
	{ icon: 'ph-image', tip: '插入图片' },
	{ icon: 'ph-list-checks', tip: '待办清单' },
];
const article = [
	'这本书最大的价值，是把「地方政府」从一个抽象的词，拆成了一套看得见的账本：钱从哪里来，花到哪里去，为什么总是不够花。',
	'第二章讲土地财政，是全书最清楚的一章。卖地收入、城投公司、基础设施投资，三件事其实是同一个循环的三个环节。',
	'第三章讲债务。作者没有简单地说「借多了不好」，而是解释了为什么在当时的约束下，借钱几乎是唯一的选择。',
	'读完最大的感受：很多看起来不合理的现象，放回它的约束条件里，就变得可以理解了。理解不等于认同，但这是讨论的起点。',
];
const routes = [
	{ name: '香山环线', meta: '8 公里 · 约 3 小时 · 难度适中' },
	{ name: '凤凰岭北线', meta: '12 公里 · 约 5 小时 · 有一段陡坡' },
	{ name: '慕田峪野长城', meta: '6 公里 · 约 2.5 小时 · 风景最好' },
];
const lanes = [
	{ id: 'out', label: '先快后慢' },
	{ id: 'in', label: '先慢后快' },
	{ id: 'inout', label: '慢快慢' },
	{ id: 'linear', label: '匀速' },
	{ id: 'back', label: '回弹' },
];
const stats = [
	{ to: 12480, suffix: '', label: '注册用户' },
	{ to: 98.6, suffix: '%', label: '满意度', decimals: 1 },
	{ to: 3200, suffix: '+', label: '每日新增' },
];
---

<article class="reading-page term-page term-page--motion" data-vibe-coding-term-detail={concept.id}>
	<div class="reading-rail">
		<a class="reading-back" href={brainPodTermReturn(concept.id)}>← 术语</a>
		<ArticleOutline headings={outline} locale="zh-CN" />
	</div>

	<header class="article-header">
		<p class="reading-kicker">术语 · {concept.categoryLabel}</p>
		<h1>{concept.chineseName}</h1>
		<p class="term-page__name" lang="en">{concept.name}</p>
		<p class="article-lede">{concept.description}</p>
	</header>

	<div class="article-main">
		<section
			class="term-section motion-tuner"
			aria-labelledby="motion-stage-title"
			data-motion-tuner
			data-motion-config={JSON.stringify(profile)}
		>
			<h2 class="term-section__title sr-only" id="motion-stage-title">亲手调一调</h2>

			<div class={`motion-stage motion-stage--${demo}`} data-motion-stage aria-hidden="true">
				{
					pointerDemo && (
						<svg class="ms-ghost" data-motion-ghost viewBox="0 0 24 24" width="22" height="22">
							<path d="M5 3l14 8-6 1.6L10 19z" />
						</svg>
					)
				}
				{
					demo === 'duration' ? (
						<div class="ms-dd">
							<span class="ms-dd__trigger">
								排序方式 <i class="ph ph-caret-down" />
							</span>
							<div class="ms-dd__menu" data-motion-target>
								<b>最新发布</b>
								<b>最多阅读</b>
								<b>最多收藏</b>
							</div>
						</div>
					) : null
				}
				{
					demo === 'easing' ? (
						<div class="ms-lanes">
							{lanes.map((lane) => (
								<div class="ms-lane" data-lane={lane.id}>
									<span>{lane.label}</span>
									<div class="ms-lane__track">
										<i data-motion-target />
									</div>
								</div>
							))}
						</div>
					) : null
				}
				{
					demo === 'spring' ? (
						<div class="ms-spring">
							<div class="ms-spring__card" data-motion-target>
								<i class="ph ph-bell-ringing" />
								<span>
									<b>新消息</b>
									<small>小明给你的作品点了赞</small>
								</span>
							</div>
						</div>
					) : null
				}
				{
					demo === 'reveal' ? (
						<div
							class="ms-scroll ms-site"
							data-motion-scroll
							tabindex="0"
							aria-label="可滚动的演示区"
						>
							<nav class="ms-site__nav">
								<b>
									<i class="ph ph-notebook" />
									小记
								</b>
								<span>功能</span>
								<span>模板</span>
								<span>价格</span>
							</nav>
							<div class="ms-site__hero">
								<h3>把灵感，随手记下来</h3>
								<p>文字、语音、图片都能记，手机和电脑实时同步。</p>
								<span class="ms-site__cta">免费下载</span>
								<small>往下滚动 ↓</small>
							</div>
							<p class="ms-site__kicker">为什么选小记</p>
							<div class="ms-cards">
								{features.map((feature) => (
									<div class="ms-card" data-motion-target>
										<i class={`ph ${feature.icon} ms-icon ms-icon--${feature.tone}`} />
										<strong>{feature.title}</strong>
										<span>{feature.text}</span>
									</div>
								))}
							</div>
							<div class="ms-site__end">
								<span class="ms-site__cta">开始记录</span>
							</div>
						</div>
					) : null
				}
				{
					demo === 'stagger' ? (
						<div class="ms-gallery">
							<p class="ms-gallery__title">小记 · 模板库</p>
							<div class="ms-tiles">
								{templates.map((template) => (
									<div class="ms-tile" data-motion-target>
										<i class={`ph ${template.icon} ms-tile__thumb ms-icon--${template.tone}`} />
										<strong>{template.title}</strong>
										<span>{template.uses}</span>
									</div>
								))}
							</div>
						</div>
					) : null
				}
				{
					demo === 'parallax' ? (
						<div
							class="ms-scroll ms-parallax"
							data-motion-scroll
							tabindex="0"
							aria-label="可滚动的演示区"
						>
							<div class="ms-parallax__inner">
								<div class="ms-parallax__bg" data-layer="bg">
									<i class="ms-sun" />
									<i class="ms-hill ms-hill--far" />
								</div>
								<div class="ms-parallax__mid" data-layer="mid">
									<i class="ms-hill ms-hill--mid" />
								</div>
								<div class="ms-parallax__content">
									<div class="ms-parallax__title">
										<h3>周末，去山里走走</h3>
										<p>30 条城市周边徒步路线，带上水就出发</p>
									</div>
									{routes.map((route) => (
										<div class="ms-parallax__panel">
											<i class="ph ph-mountains ms-icon ms-icon--green" />
											<span>
												<strong>{route.name}</strong>
												<small>{route.meta}</small>
											</span>
										</div>
									))}
								</div>
							</div>
						</div>
					) : null
				}
				{
					demo === 'lift' ? (
						<div class="ms-lift">
							{templates.slice(0, 3).map((template) => (
								<div class="ms-lift__card" data-motion-target>
									<i class={`ph ${template.icon} ms-tile__thumb ms-icon--${template.tone}`} />
									<strong>{template.title}</strong>
									<span>{template.uses}</span>
								</div>
							))}
						</div>
					) : null
				}
				{
					demo === 'press' ? (
						<div class="ms-press">
							<span class="ms-press__button" data-motion-target>
								<i class="ph ph-download-simple" />
								免费下载小记
							</span>
							<small>支持 iPhone、安卓、Mac 和 Windows</small>
						</div>
					) : null
				}
				{
					demo === 'magnetic' ? (
						<div class="ms-magnetic">
							<p>准备好开始记录了吗？</p>
							<span class="ms-magnetic__button" data-motion-target>
								开始使用
								<i class="ph ph-arrow-right" />
							</span>
						</div>
					) : null
				}
				{
					demo === 'spotlight' ? (
						<div class="ms-spot" data-motion-target>
							<span class="ms-spot__badge">小记 Pro</span>
							<strong>无限空间，所有设备同步</strong>
							<p>语音转文字不限时长，历史版本保留一年。</p>
							<span class="ms-site__cta">升级 Pro · ¥12/月</span>
						</div>
					) : null
				}
				{
					demo === 'tilt' ? (
						<div class="ms-tilt">
							<div class="ms-tilt__card" data-motion-target>
								<span class="ms-tilt__glare" />
								<b>
									<i class="ph ph-notebook" />
									小记 · 会员卡
								</b>
								<strong>PRO</strong>
								<span>No. 0024 6801 · 有效期至 2027.10</span>
							</div>
						</div>
					) : null
				}
				{
					demo === 'ripple' ? (
						<div class="ms-press">
							<span class="ms-press__button ms-ripple" data-motion-target>
								<i class="ph ph-floppy-disk" />
								保存笔记
							</span>
							<small>周报 · 2026 年第 41 周</small>
						</div>
					) : null
				}
				{
					demo === 'like' ? (
						<div class="ms-like-post">
							<div class="ms-like-post__head">
								<i class="ph ph-book-open ms-icon ms-icon--amber" />
								<span>
									<strong>《置身事内》读书笔记</strong>
									<small>阿青 · 3 小时前</small>
								</span>
							</div>
							<p>地方政府的「土地财政」这一章写得最清楚，第一次看懂了城投是怎么回事。</p>
							<span class="ms-like" data-motion-target>
								<span class="ms-like__burst" data-motion-burst />
								<svg viewBox="0 0 24 24" width="22" height="22" class="ms-like__heart">
									<path d="M12 20.5s-7.5-4.6-9.3-9.2C1.4 8 3.6 4.5 7.2 4.5c2 0 3.6 1.1 4.8 2.8 1.2-1.7 2.8-2.8 4.8-2.8 3.6 0 5.8 3.5 4.5 6.8-1.8 4.6-9.3 9.2-9.3 9.2z" />
								</svg>
								<b data-motion-count>128</b>
							</span>
						</div>
					) : null
				}
				{
					demo === 'toggle' ? (
						<div class="ms-settings">
							<div class="ms-settings__row">
								<span>
									<strong>自动同步</strong>
									<small>在手机和电脑之间同步笔记</small>
								</span>
								<span class="ms-switch" data-motion-target>
									<i />
								</span>
							</div>
							<div class="ms-settings__row is-muted">
								<span>
									<strong>仅在 Wi-Fi 下同步图片</strong>
									<small>节省流量</small>
								</span>
								<span class="ms-switch is-on">
									<i />
								</span>
							</div>
						</div>
					) : null
				}
				{
					demo === 'loading' ? (
						<div class="ms-form">
							<label class="ms-field">
								<span class="ms-field__label is-up">意见反馈</span>
								<span class="ms-field__value">希望能支持导出成 PDF</span>
							</label>
							<span
								class="ms-load"
								data-motion-target
								data-state="idle"
								data-waiting="spinner"
								data-shape="keep"
							>
								<span class="ms-load__text">提交</span>
								<span class="ms-load__spinner" />
								<span class="ms-load__dots">
									<i />
									<i />
									<i />
								</span>
								<span class="ms-load__busy">提交中…</span>
								<span class="ms-load__done">
									<i class="ph ph-check" />
									已提交
								</span>
							</span>
						</div>
					) : null
				}
				{
					demo === 'shake' ? (
						<div class="ms-form">
							<p class="ms-form__title">登录小记</p>
							<label class="ms-field">
								<span class="ms-field__label is-up">邮箱</span>
								<span class="ms-field__value">aqing@example.com</span>
							</label>
							<label class="ms-field" data-motion-field>
								<span class="ms-field__label is-up">密码</span>
								<span class="ms-field__value">••••••••</span>
							</label>
							<small class="ms-form__error" data-motion-error>
								<i class="ph ph-warning-circle" />
								密码不正确，请重新输入
							</small>
							<span class="ms-load ms-form__submit" data-motion-target>
								<span class="ms-load__text">登录</span>
							</span>
						</div>
					) : null
				}
				{
					demo === 'focus' ? (
						<div class="ms-form">
							<p class="ms-form__title">订阅小记周刊</p>
							<label class="ms-field ms-field--focus" data-motion-target>
								<span class="ms-field__label">邮箱地址</span>
								<span class="ms-field__value" data-motion-typed />
								<i class="ms-field__caret" />
							</label>
							<small class="ms-form__note">每周五早上 8 点，一封邮件，可以随时退订</small>
						</div>
					) : null
				}
				{
					demo === 'scrolly' ? (
						<div
							class="ms-scroll ms-scrolly"
							data-motion-scroll
							tabindex="0"
							aria-label="可滚动的演示区"
						>
							<div class="ms-scrolly__steps">
								{storySteps.map((step, index) => (
									<div class="ms-scrolly__step" data-step={index}>
										<small>0{index + 1}</small>
										<strong>{step.title}</strong>
										<p>{step.text}</p>
									</div>
								))}
							</div>
							<div class="ms-scrolly__sticky">
								<div class="ms-phone">
									{storySteps.map((step, index) => (
										<div class="ms-phone__screen" data-screen={index}>
											<i class={`ph ${step.icon} ms-icon ms-icon--${step.tone}`} />
											<b>{step.screen}</b>
											<span />
											<span />
											<span class="is-short" />
										</div>
									))}
								</div>
							</div>
						</div>
					) : null
				}
