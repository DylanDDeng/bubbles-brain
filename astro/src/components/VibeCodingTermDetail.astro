---
import type { VibeCodingConcept } from '../data/vibeCodingTerms';
import { brainPodTermReturn } from '../lib/brainpodTerms';
import type { VibeCodingDetailProfile } from '../data/vibeCodingTermDetails';
import { vibeCodingLabTitle } from '../data/vibeCodingLabTitles';
import ArticleOutline from './ArticleOutline.astro';
import VibeCodingConceptVisual from './VibeCodingConceptVisual.astro';
import VibeCodingFlowLab from './VibeCodingFlowLab.astro';
import ConfidenceIntervalExample from './ConfidenceIntervalExample.astro';
import '../styles/reading-page.css';
import '../styles/vibe-coding-term-detail.css';
import '../styles/term-page.css';

interface Props {
	concept: VibeCodingConcept;
	profile: VibeCodingDetailProfile;
	previousConcept: VibeCodingConcept | null;
	nextConcept: VibeCodingConcept | null;
}

const { concept, profile, previousConcept, nextConcept } = Astro.props;
const isConfidence = concept.id === 'confidence-interval';
const labTitle = vibeCodingLabTitle(concept, profile.visualTitle);
// The same reading layout as a tutorial: the way back and this page's sections on the left,
// a 540px column in the middle. Each heading is the content itself, not a numbered label.
const outline = [
	{ slug: 'term-analogy', text: '换个角度想' },
	{ slug: 'term-lab', text: labTitle },
	{ slug: 'term-scenes', text: '什么时候会遇到它' },
	{ slug: 'term-practice', text: '想一想' },
	{ slug: 'term-warning', text: '最容易踩的坑' },
].map((heading) => ({ ...heading, depth: 2 }));
---

<article class="reading-page term-page" data-vibe-coding-term-detail={concept.id}>
	<div class="reading-rail">
		<a class="reading-back" href={brainPodTermReturn(concept.id)}>← 术语</a>
		<ArticleOutline headings={outline} locale="zh-CN" />
	</div>

	<header class="article-header">
		<p class="reading-kicker">
			{concept.isCategory ? '术语' : `术语 · ${concept.categoryLabel}`}
		</p>
		<h1>{concept.chineseName}</h1>
		{concept.name !== concept.chineseName && <p class="term-page__name" lang="en">{concept.name}</p>}
		<p class="article-lede">{concept.description}</p>
	</header>

	<div class="article-main">
		{
			isConfidence ? (
				<ConfidenceIntervalExample mode="overview" />
			) : (
				<VibeCodingConceptVisual concept={concept} profile={profile} />
			)
		}

		<div class="article-content term-page__body">
			<h2 id="term-analogy">换个角度想</h2>
			{profile.analogy.split('\n\n').map((paragraph) => <p>{paragraph}</p>)}

			<h2 id="term-lab">{labTitle}</h2>
		</div>
		{/* Outside .article-content, so the article's paragraph and code styles stay out of the demo. */}
		{
			isConfidence ? (
				<ConfidenceIntervalExample mode="lab" />
			) : (
				<VibeCodingFlowLab concept={concept} profile={profile} />
			)
		}

		<div class="article-content term-page__body">
			<h2 id="term-scenes">什么时候会遇到它</h2>
			<ol class="term-scenes">
				{
					profile.scenes.map((scene, index) => (
						<li>
							<span class="term-scenes__mark" aria-hidden="true">
								{index + 1}
							</span>
							<h3>{scene.title}</h3>
							<p>{scene.description}</p>
						</li>
					))
				}
			</ol>

			<h2 id="term-practice">想一想</h2>
			<p>{profile.practice.question}</p>
			<details class="term-answer">
				<summary>
					看答案 <i class="ph ph-caret-down" aria-hidden="true"></i>
				</summary>
				<p>{profile.practice.answer}</p>
			</details>

			<h2 id="term-warning">最容易踩的坑</h2>
			<p>{profile.warning}</p>
		</div>

		<footer class="article-ending">
			{
				(previousConcept || nextConcept) && (
					<nav class="article-pagination" aria-label="相邻术语">
						{previousConcept && (
							<a
								href={`/vibe-coding/terms/${previousConcept.id}/`}
								class="article-previous"
								rel="prev"
							>
								<span>← 上一个</span>
								<strong class="article-pagination-title">{previousConcept.chineseName}</strong>
							</a>
						)}
						{nextConcept && (
							<a href={`/vibe-coding/terms/${nextConcept.id}/`} class="article-next" rel="next">
								<span>下一个 →</span>
								<strong class="article-pagination-title">{nextConcept.chineseName}</strong>
							</a>
						)}
					</nav>
				)
			}
		</footer>
	</div>
</article>

<script>
	import '../scripts/article-outline.ts';
</script>
