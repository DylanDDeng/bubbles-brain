---
import { buildBrainPodLibrary } from '../lib/brainpod';
import { buildKnowledgeSearchIndex } from '../lib/searchIndex';

interface Props {
	/** The Vibe Coding part this page shows; it is left out of the list. */
	current: 'terms' | 'skills' | 'design' | 'showcase';
}
const { current } = Astro.props;
const library = buildBrainPodLibrary(await buildKnowledgeSearchIndex({ locale: 'zh-CN' }));
const count = (id: string) => library.collections.find((c) => c.id === id)?.items.length ?? 0;
const parts = [
	{ id: 'terms', label: '术语', href: '/vibe-coding/terms/', count: count('vibe-coding-terms') },
	{ id: 'skills', label: 'Skills', href: '/vibe-coding/skills/', count: count('vibe-coding-skills') },
	{ id: 'design', label: 'Design', href: '/vibe-coding/design/', count: count('vibe-coding-design') },
	{
		id: 'showcase',
		label: 'Showcase',
		href: '/vibe-coding/showcase/',
		count: count('vibe-coding-showcase'),
	},
].filter((part) => part.id !== current);
---

<nav class="dir-siblings" aria-label="Vibe Coding 的其他部分">
	<span class="meta-line">同馆</span>
	{
		parts.map((part) => (
			<a href={part.href}>
				{part.label} <span class="rr-count">{part.count}</span>
			</a>
		))
	}
</nav>
