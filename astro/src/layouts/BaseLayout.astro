---
import '../styles/migration.css';
import '../styles/ricoui-theme.css';
import '../styles/collection-pages.css';
import { ClientRouter } from 'astro:transitions';
import SiteActions from '../components/SiteActions.astro';
import CommandSearch from '../components/CommandSearch.astro';
import { CAT_CURATOR_AVATAR } from '../data/catCurator';

interface Props {
	title: string;
	description?: string;
	lang?: 'zh-CN' | 'en';
	alternateHref?: string | null;
	canonicalPath?: string;
	noindex?: boolean;
	section?: string;
	immersive?: boolean;
}

const {
	title,
	description = "Bubble's Brain personal knowledge base",
	lang = 'zh-CN',
	alternateHref = null,
	canonicalPath = Astro.url.pathname,
	noindex = false,
	immersive = false,
} = Astro.props;

const isEnglish = lang === 'en';
const homeHref = isEnglish ? '/en/' : '/';
const languageHref = alternateHref ?? (isEnglish ? '/' : '/en/');
const canonicalUrl = new URL(canonicalPath, Astro.site);
const alternateUrl = alternateHref ? new URL(alternateHref, Astro.site) : null;
---

<!doctype html>
<html lang={lang} data-theme="light">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#ffffff" />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta name="twitter:card" content="summary" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" hreflang={lang} href={canonicalUrl} />
		{
			alternateUrl && (
				<link rel="alternate" hreflang={isEnglish ? 'zh-CN' : 'en'} href={alternateUrl} />
			)
		}
		<link
			rel="alternate"
			hreflang="x-default"
			href={isEnglish && alternateUrl ? alternateUrl : canonicalUrl}
		/>
		<title>{title}</title>
		<ClientRouter fallback="swap" />
		<script is:inline type="module" src="/js/navigation.js"></script>
		<script
			is:inline
			defer
			src="https://cloud.umami.is/script.js"
			data-website-id="2a4e6219-c7bc-4336-96e3-5d1dc2f0b330"></script>
	</head>
	<body class="collection-site">
		<a class="skip-link" href="#main-content">{isEnglish ? 'Skip to content' : '跳到正文'}</a>
		<div class:list={['site-frame', { 'site-frame--immersive': immersive }]}>
			{
				!immersive && (
					<header class="site-header">
						<a
							class="site-home"
							href={homeHref}
							aria-label={isEnglish ? "Bubble's Brain home" : "Bubble's Brain 首页"}
						>
							<>
								<img
									class="site-avatar"
									src={CAT_CURATOR_AVATAR}
									alt=""
									width="36"
									height="36"
								/>
								<span>Bubble’s Brain</span>
							</>
						</a>
						<SiteActions locale={lang} languageHref={languageHref} />
					</header>
				)
			}
			<div class="site-canvas">
				<main id="main-content" tabindex="-1"><slot /></main>
				{
					!immersive && (
						<footer class="site-footer">
							<a href={homeHref}>Bubble’s Brain</a>
							<nav aria-label={isEnglish ? 'More' : '更多'}>
								<a href={isEnglish ? '/en/about/' : '/about/'}>{isEnglish ? 'About' : '关于'}</a>
								{!isEnglish && <a href="/changelog/">更新</a>}
								<a href={isEnglish ? '/en/rss.xml' : '/rss.xml'}>RSS</a>
								<a
									href="https://github.com/DylanDDeng/bubbles-brain"
									target="_blank"
									rel="noopener noreferrer"
								>
									GitHub
								</a>
								<a href={languageHref}>{isEnglish ? '中文' : 'EN'}</a>
							</nav>
						</footer>
					)
				}
			</div>
		</div>
		<CommandSearch locale={lang} />
		<script is:inline type="module" src="/js/site-shell.js"></script>
	</body>
</html>
