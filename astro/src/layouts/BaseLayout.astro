---
import '../styles/migration.css';
import '../styles/ricoui-theme.css';
import '../styles/reading-room.css';
import '../styles/collection-pages.css';
import '../styles/news-hints.css';
import { ClientRouter } from 'astro:transitions';
import SiteActions from '../components/SiteActions.astro';
import FooterLinks from '../components/FooterLinks.astro';
import CommandSearch from '../components/CommandSearch.astro';
import { activeSiteSection, siteSections } from '../lib/siteSections';

interface Props {
	title: string;
	description?: string;
	lang?: 'zh-CN' | 'en';
	alternateHref?: string | null;
	canonicalPath?: string;
	noindex?: boolean;
	section?: string;
	immersive?: boolean;
	/** The home page keeps only the quiet links in its header and has no footer. */
	home?: boolean;
}

const {
	title,
	description = "Bubble's Brain personal knowledge base",
	lang = 'zh-CN',
	alternateHref = null,
	canonicalPath = Astro.url.pathname,
	noindex = false,
	immersive = false,
	home = false,
} = Astro.props;

const isEnglish = lang === 'en';
const homeHref = isEnglish ? '/en/' : '/';
const languageHref = alternateHref ?? (isEnglish ? '/' : '/en/');
const canonicalUrl = new URL(canonicalPath, Astro.site);
const alternateUrl = alternateHref ? new URL(alternateHref, Astro.site) : null;
const sections = siteSections(lang);
const currentSection = activeSiteSection(Astro.url.pathname, lang);
// The search page has its own search box; a second one in the header would only repeat it.
const isSearchPage = Astro.url.pathname.replace(/\/$/, '') === '/search';
---

<!doctype html>
<html lang={lang} data-theme="light">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#ffffff" />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta name="twitter:card" content="summary" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" hreflang={lang} href={canonicalUrl} />
		{
			alternateUrl && (
				<link rel="alternate" hreflang={isEnglish ? 'zh-CN' : 'en'} href={alternateUrl} />
			)
		}
		<link
			rel="alternate"
			hreflang="x-default"
			href={isEnglish && alternateUrl ? alternateUrl : canonicalUrl}
		/>
		<title>{title}</title>
		<ClientRouter fallback="swap" />
		<script is:inline type="module" src="/js/navigation.js"></script>
		<script
			is:inline
			defer
			src="https://cloud.umami.is/script.js"
			data-website-id="2a4e6219-c7bc-4336-96e3-5d1dc2f0b330"></script>
	</head>
	<body class="collection-site">
		<a class="skip-link" href="#main-content">{isEnglish ? 'Skip to content' : '跳到正文'}</a>
		<div class:list={['site-frame', { 'site-frame--immersive': immersive }]}>
			{
				!immersive && home && (
					<header class="site-header site-header--home">
						<SiteActions locale={lang} languageHref={languageHref} home />
					</header>
				)
			}
			{
				!immersive && !home && (
					<header class="site-header">
						<a
							class="site-home"
							href={homeHref}
							data-nav-prefetch
							aria-label={isEnglish ? "Bubble's Brain home" : "Bubble's Brain 首页"}
						>
							<img
								class="site-avatar"
								src="/images/cat-curator.jpg"
								alt=""
								width="28"
								height="28"
							/>
							<span>Bubble's Brain</span>
						</a>
						{isSearchPage ? (
							<span aria-hidden="true" />
						) : (
							<a
								class="site-search"
								href="/search/"
								data-command-search-trigger
								aria-label={isEnglish ? 'Search (⌘K)' : '搜索（⌘K）'}
							>
								<i class="ph ph-magnifying-glass" aria-hidden="true" />
								<span>{isEnglish ? 'Search' : '搜索'}</span>
								<kbd>⌘K</kbd>
							</a>
						)}
						<div class="site-nav">
							<nav class="site-sections" aria-label={isEnglish ? 'Sections' : '栏目'}>
								{sections.map((item) => (
									<a
										href={item.href}
										aria-current={item.id === currentSection ? 'page' : undefined}
										data-nav-prefetch
									>
										{item.label}
									</a>
								))}
							</nav>
							<SiteActions locale={lang} languageHref={languageHref} />
							<details class="site-menu">
								<summary aria-label={isEnglish ? 'Sections' : '打开栏目'}>
									<i class="ph ph-list" aria-hidden="true" />
								</summary>
								<nav aria-label={isEnglish ? 'Sections' : '栏目'}>
									{sections.map((item) => (
										<a
											href={item.href}
											aria-current={item.id === currentSection ? 'page' : undefined}
										>
											{item.label}
										</a>
									))}
									<a href="/changelog/">{isEnglish ? 'Updates' : '更新日志'}</a>
									<a href={isEnglish ? '/en/about/' : '/about/'}>{isEnglish ? 'About' : '关于'}</a>
									<a href={languageHref}>{isEnglish ? '中文' : 'English'}</a>
								</nav>
							</details>
						</div>
					</header>
				)
			}
			<div class="site-canvas">
				<main id="main-content" tabindex="-1"><slot /></main>
				{
					!immersive && (
						<footer class="site-footer">
							<FooterLinks locale={lang} />
						</footer>
					)
				}
			</div>
		</div>
		<CommandSearch locale={lang} />
		{/* Read out when the AI 动态 notice appears (scripts/newsHints.ts). */}
		<div class="sr-only" role="status" data-news-notice-status></div>
		<script>
			import '../scripts/instantNavigation';
			import '../scripts/readingUpdates';
			import '../scripts/newsHints';
		</script>
		<script is:inline type="module" src="/js/site-shell.js"></script>
	</body>
</html>
