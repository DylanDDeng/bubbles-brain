---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteSections } from '../lib/siteSections';
import '../styles/home.css';

const sections = siteSections('zh-CN');
---

<BaseLayout
	title="页面未找到 · Bubble's Brain"
	description="请求的页面不存在或已经移动。"
	canonicalPath="/404"
	alternateHref="/en/404"
	noindex={true}
>
	<div class="home not-found">
		<img
			class="home-cat"
			src="/images/cat-pose-5.jpg"
			alt="在地上打滚的猫馆长"
			width="1100"
			height="765"
		/>
		<p class="not-found__code">404</p>
		<h1 class="not-found__title">这一页被猫弄丢了。</h1>
		<p class="home-lede">链接可能改过地址。搜一下，多半还在。</p>
		<form class="home-search" action="/search/" method="get" role="search">
			<i class="ph ph-magnifying-glass" aria-hidden="true"></i>
			<label class="sr-only" for="not-found-query">搜索知识库</label>
			<input
				id="not-found-query"
				name="q"
				type="search"
				autocomplete="off"
				placeholder="搜索整个知识库"
			/>
		</form>
		<nav class="home-sections" aria-label="栏目">
			{sections.map((section) => <a href={section.href}>{section.label}</a>)}
		</nav>
	</div>
</BaseLayout>
