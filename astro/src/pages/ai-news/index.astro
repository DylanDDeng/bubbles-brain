---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AI_NEWS_FEED_URL } from '../../lib/aiNews';
import '../../styles/ai-news.css';
---

<BaseLayout
	title="AI 动态 · Bubble's Brain"
	description="每小时更新的 AI 新闻：一句话讲清发生了什么，点开读原文。"
>
	<div class="news-page" data-ai-news data-feed-url={AI_NEWS_FEED_URL}>
		<header class="rr-head">
			<h1 class="rr-title">AI 动态</h1>
			<p class="news-updated" data-news-updated aria-live="polite"></p>
		</header>

		<div class="news-body">
			<nav class="news-rail" aria-label="日期" data-news-rail></nav>

			<div class="news-main" aria-busy="true" data-news-main>
				<h2 class="news-day" data-news-title></h2>
				{/* Shown when stories came while the page was open; a click puts them on top. */}
				<div class="news-fresh" role="status">
					<button class="news-fresh__button" type="button" data-news-fresh hidden>
						<i class="ph ph-arrow-up" aria-hidden="true"></i>
						<span data-news-fresh-label></span>
					</button>
				</div>
				{/* 热门: what the hot bot found most widely reported in the last day, above today only. */}
				<section class="news-hot" aria-labelledby="news-hot-title" data-news-hot hidden>
					<div class="news-hot__head">
						<h3 class="news-hot__title" id="news-hot-title">热门</h3>
						<span class="news-hot__window">过去 24 小时</span>
					</div>
					<div class="news-hot__cards" data-news-hot-cards></div>
				</section>
				<h3 class="news-all" data-news-all hidden>全部</h3>
				<div class="news-timeline" data-news-grid></div>
				<p class="rr-empty" data-news-status>正在读取最新动态…</p>
				<noscript
					><p class="rr-empty">AI 动态每小时更新，需要打开 JavaScript 才能看到。</p></noscript
				>
				<div class="news-next">
					<button type="button" data-news-older hidden>
						<span data-news-older-label></span>
						<i class="ph ph-arrow-right" aria-hidden="true"></i>
					</button>
				</div>
			</div>
			{/* When this comes into view the reader is at the end: the veil steps aside. */}
			<div class="news-end" data-news-end></div>
		</div>

		{/* Frosted edge at the bottom of the screen: cards blur out as they scroll under it. */}
		<div class="news-veil" aria-hidden="true" data-news-veil><i></i><i></i><i></i><i></i></div>
	</div>
</BaseLayout>

<script>
	import '../../scripts/aiNews';
</script>
