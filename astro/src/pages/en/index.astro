---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildKnowledgeSearchIndex } from '../../lib/searchIndex';
import { siteSections } from '../../lib/siteSections';
import { benchmarkLedger } from '../../lib/benchmarks';
import '../../styles/home.css';

const index = await buildKnowledgeSearchIndex({ locale: 'en' });
const highlights = index.items.filter((item) => item.section === 'highlights');
const counts: Record<string, number> = {
	highlights: highlights.length,
	benchmarks: benchmarkLedger.benchmarks.length,
};
const sections = siteSections('en').map((section) => ({ ...section, count: counts[section.id] }));
const recent = highlights.slice(0, 5);
---

<BaseLayout
	title="Bubble's Brain · Personal AI knowledge archive"
	description="A personal collection of AI knowledge, primary sources and practical guides."
	lang="en"
	alternateHref="/"
	home
>
	<div class="home">
		<img
			class="home-cat"
			src="/images/cat-pose-3.jpg"
			alt="The cat curator standing, a pencil drawing"
			width="1100"
			height="765"
		/>
		<h1 class="home-title">Bubble's Brain</h1>
		<p class="home-lede">A personal AI knowledge base, kept by a cat.</p>
		<nav class="home-sections" aria-label="Sections">
			{
				sections.map((section) => (
					<a href={section.href}>
						{section.label}
						{section.count !== undefined && <span>{section.count}</span>}
					</a>
				))
			}
		</nav>
		<section class="home-list" aria-labelledby="en-recent">
			<h2 id="en-recent">Recent highlights</h2>
			<ol class="rr-rows">
				{
					recent.map((item) => (
						<li>
							<a
								class="rr-row"
								href={item.href}
								target={item.external ? '_blank' : undefined}
								rel={item.external ? 'noopener noreferrer' : undefined}
							>
								<span class="rr-row__title">{item.title}</span>
								<span class="rr-row__side">{item.date?.slice(5, 10).replace('-', '.')}</span>
							</a>
						</li>
					))
				}
			</ol>
			<a class="rr-more" href="/en/highlights/">All highlights</a>
		</section>
	</div>
</BaseLayout>
