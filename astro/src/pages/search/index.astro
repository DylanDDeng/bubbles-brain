---
import BaseLayout from '../../layouts/BaseLayout.astro';
import KnowledgeResults from '../../components/KnowledgeResults.astro';
import { buildKnowledgeSearchIndex } from '../../lib/searchIndex';
import '../../styles/knowledge.css';

const index = await buildKnowledgeSearchIndex();
const sectionLabels = new Map(index.items.map((item) => [item.section, item.section_label]));
---

<BaseLayout
	title="知识搜索 · Bubble's Brain"
	description="搜索教程、精选阅读、Vibe Coding 术语、Skills 与 Design"
>
	<section class="rr-page knowledge-search" data-knowledge-search>
		<h1 class="sr-only">搜索知识库</h1>
		<form class="knowledge-search-form" data-knowledge-search-form method="get" role="search">
			<label class="knowledge-query">
				<i class="ph ph-magnifying-glass" aria-hidden="true"></i>
				<span class="sr-only">搜索词</span>
				<input
					id="knowledge-query"
					name="q"
					type="search"
					autocomplete="off"
					placeholder="搜索标题、术语、摘要或标签"
				/>
			</label>
			<button class="sr-only" type="submit">搜索</button>
			<div class="knowledge-search-bar">
				<label class="sr-only" for="knowledge-section">知识栏目</label>
				<select id="knowledge-section" name="section" hidden tabindex="-1" aria-hidden="true">
					<option value="">全部栏目</option>
					{
						index.sections.map((section) => (
							<option value={section}>{sectionLabels.get(section)}</option>
						))
					}
				</select>
				<details class="knowledge-filter" data-knowledge-filter-menu>
					<summary>
						<span data-knowledge-filter-label>全部栏目</span>
						<i class="ph ph-caret-down" aria-hidden="true"></i>
					</summary>
					<div class="knowledge-filter__options" role="menu" aria-label="选择知识栏目">
						<button type="button" role="menuitemradio" aria-checked="true" data-section-value="">
							全部栏目
						</button>
						{
							index.sections.map((section) => (
								<button
									type="button"
									role="menuitemradio"
									aria-checked="false"
									data-section-value={section}
								>
									{sectionLabels.get(section)}
								</button>
							))
						}
					</div>
				</details>
				{/* Not shown on the page; screen readers still hear how many results there are. */}
				<span class="sr-only" aria-live="polite">
					<span data-search-result-count>{index.item_count}</span> 条结果
				</span>
			</div>
		</form>
		<noscript><p class="rr-empty">JavaScript 关闭时展示完整知识索引。</p></noscript>

		<KnowledgeResults items={index.items} filterable />
		<div class="knowledge-empty" data-search-empty hidden={index.item_count !== 0}>
			<img src="/images/cat-pose-4.jpg" alt="趴着的猫馆长" width="1100" height="765" />
			<div>
				<p class="knowledge-empty__title">
					{index.item_count === 0 ? '知识库还没有可检索的内容。' : '没有找到。换个说法试试？'}
				</p>
				{
					index.item_count > 0 && (
						<button type="button" data-clear-search>
							清除搜索
						</button>
					)
				}
			</div>
		</div>
	</section>
</BaseLayout>

<script is:inline type="module" src="/js/knowledge-search.js"></script>
