---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
	loadDirectoryData,
	newbieMark,
	seriesLessons,
	TUTORIAL_SERIES,
} from '../../lib/directories';
import '../../styles/directories.css';

const data = await loadDirectoryData();
const series = TUTORIAL_SERIES.map((meta) => ({
	...meta,
	title: data.collection(meta.id)?.title ?? meta.id,
	lessons: seriesLessons(data, meta.id),
}));
const total = series.reduce((sum, item) => sum + item.lessons.length, 0);
---

<BaseLayout
	title="教程 · Bubble's Brain"
	description="从一个好问题开始，到让 Agent 替你把项目做出来。新手村、Codex、Pi Agent、WorkBuddy 四个系列。"
>
	<div class="rr-page">
		<header class="rr-head">
			<div class="rr-head__text">
				<nav class="rr-crumbs" aria-label="位置"><a href="/">首页</a> / 教程</nav>
				<h1 class="rr-title">教程</h1>
				<p class="rr-lede">从一个好问题开始，到让 Agent 替你把项目做出来。四个系列，按顺序读最省力。</p>
				<span class="meta-line">{total} 篇 · {series.length} 个系列</span>
			</div>
			<img
				class="rr-cat dir-head-cat"
				src="/images/cat-pose-4.jpg"
				alt="趴着的猫馆长"
				width="1100"
				height="765"
			/>
		</header>

		{
			series.map((item, seriesIndex) => (
				<section
					class="rr-split dir-series"
					id={item.id}
					aria-labelledby={`series-${item.id}`}
				>
					<div class="rr-split__label">
						<span class:list={['rr-count', { 'rr-kicker': seriesIndex === 0 }]}>
							{item.level} · {item.lessons.length} {item.id === 'newbie-tutorials' ? '课' : '篇'}
						</span>
						<h2 id={`series-${item.id}`}>{item.title}</h2>
						<p>{item.lede}</p>
					</div>
					<ol class="dir-lessons">
						{item.lessons.map((lesson, index) => {
							const mark = item.id === 'newbie-tutorials' ? newbieMark(lesson) : undefined;
							return (
								<li>
									<a class="dir-lesson" href={lesson.href}>
										{mark ? (
											<span class:list={['dir-lesson__mark', { 'is-first': index === 0 }]}>
												{mark}
											</span>
										) : (
											<span class="dir-lesson__no">{String(index + 1).padStart(2, '0')}</span>
										)}
										<span class="dir-lesson__title">{lesson.title}</span>
									</a>
								</li>
							);
						})}
					</ol>
				</section>
			))
		}
	</div>
</BaseLayout>
