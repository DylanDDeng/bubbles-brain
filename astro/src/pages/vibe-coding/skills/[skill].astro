---
import { getCollection } from 'astro:content';
import ArticleOutline from '../../../components/ArticleOutline.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
	vibeCodingSkillCategories,
	vibeCodingSkillFamilies,
	vibeCodingSkillMeta,
} from '../../../data/vibeCodingSkills';
import '../../../styles/reading-page.css';
import '../../../styles/skill-page.css';

interface Props {
	entry: Awaited<ReturnType<typeof getCollection<'skills'>>>[number];
	previousEntry: Awaited<ReturnType<typeof getCollection<'skills'>>>[number] | null;
	nextEntry: Awaited<ReturnType<typeof getCollection<'skills'>>>[number] | null;
}

export async function getStaticPaths() {
	const entries = await getCollection('skills');
	const categoryOrder = new Map(
		vibeCodingSkillCategories.map((category, index) => [category.id, index]),
	);
	const sorted = [...entries].sort((a, b) => {
		const categoryDiff =
			(categoryOrder.get(a.data.category) ?? categoryOrder.size) -
			(categoryOrder.get(b.data.category) ?? categoryOrder.size);
		if (categoryDiff !== 0) return categoryDiff;
		return (a.data.order ?? 0) - (b.data.order ?? 0);
	});
	return sorted.map((entry, index) => ({
		params: { skill: entry.id },
		props: {
			entry,
			previousEntry: sorted[index - 1] ?? null,
			nextEntry: sorted[index + 1] ?? null,
		},
	}));
}

const { entry, previousEntry, nextEntry } = Astro.props;
const meta = vibeCodingSkillMeta[entry.id];
const category = vibeCodingSkillCategories.find(
	(candidate) => candidate.id === entry.data.category,
);
const rawBody = entry.body ?? '';
const rawLineCount = rawBody ? rawBody.trimEnd().split('\n').length : 0;
const family = vibeCodingSkillFamilies.find((candidate) => candidate.skillIds.includes(entry.id));
const companions = (family?.skillIds ?? [])
	.filter((id) => id !== entry.id)
	.map((id) => ({
		id,
		meta: vibeCodingSkillMeta[id],
		isEntry: family?.skillIds[0] === id,
	}));
const sourceHost = new URL(entry.data.sourceUrl).host;
// The same reading layout as a term page: the way back and this page's sections on the left,
// a 540px column in the middle.
const outline = [
	{ slug: 'skill-install', text: '装进你的 AI 编码工具' },
	{ slug: 'skill-doc', text: 'SKILL.md 原文' },
	...(companions.length ? [{ slug: 'skill-companions', text: '同套件技能' }] : []),
].map((heading) => ({ ...heading, depth: 2 }));
---

<BaseLayout
	title={meta
		? `${meta.chineseName}（${entry.data.name}）· Vibe Coding Skills`
		: `${entry.data.name} · Vibe Coding Skills`}
	description={meta?.description ?? entry.data.name}
	canonicalPath={`/vibe-coding/skills/${entry.id}/`}
	section="vibe-coding"
>
	<article class="reading-page skill-page">
		<div class="reading-rail">
			<a class="reading-back" href={`/vibe-coding/skills/${category ? `#${category.id}` : ''}`}>
				← Skills
			</a>
			<ArticleOutline headings={outline} locale="zh-CN" />
		</div>

		<header class="article-header">
			<p class="reading-kicker">{category ? `Skills · ${category.label}` : 'Skills'}</p>
			<h1>{meta?.chineseName ?? entry.data.name}</h1>
			{
				meta && (
					<p class="skill-page__name" lang="en">
						{entry.data.name}
					</p>
				)
			}
			{meta && <p class="article-lede">{meta.description}</p>}
			<p class="reading-meta">
				<span>
					{'作者 '}
					<a href={`https://github.com/${entry.data.author}/`} rel="noopener" target="_blank">
						{entry.data.author}
					</a>
				</span>
				<span>
					{'来源 '}
					<a href={entry.data.sourceUrl} rel="noopener" target="_blank">{sourceHost}</a>
				</span>
			</p>
		</header>

		<div class="article-main">
			<div class="article-content">
				<h2 id="skill-install">装进你的 AI 编码工具</h2>
				<p>在项目里运行这一行，AI 编码工具就会装上这个技能。</p>
			</div>
			<div class="skill-install-box">
				<code>{entry.data.install}</code>
				<button type="button" class="skill-copy" data-copy-install>复制</button>
			</div>

			<div class="article-content">
				<h2 id="skill-doc">SKILL.md 原文</h2>
				<p>装好之后，AI 编码工具就照这份说明书理解触发条件、执行步骤和质量要求。</p>
			</div>
			<details class="skill-raw">
				<summary>
					<code>skills/{entry.id}/SKILL.md</code>
					<span class="skill-raw__lines">{rawLineCount} 行</span>
					<span class="skill-raw__toggle">展开</span>
				</summary>
				<div class="skill-raw__tools">
					<button type="button" class="skill-copy" data-copy-raw>复制全文</button>
				</div>
				<pre tabindex="0" data-raw-content>{rawBody}</pre>
			</details>
			<p class="article-editorial-note">
				正文为未经删改的英文 SKILL.md 原文，出自
				<a href={entry.data.sourceUrl} rel="noopener" target="_blank">{sourceHost}</a>
				（作者 {entry.data.author}）；中文导读为本站原创。
			</p>

			{
				companions.length > 0 && (
					<div class="article-content">
						<h2 id="skill-companions">同套件技能</h2>
						<ul class="skill-companions">
							{companions.map((member) => (
								<li>
									<a href={`/vibe-coding/skills/${member.id}/`}>
										{member.meta?.chineseName ?? member.id}
									</a>
									<span>{member.isEntry ? '套件入口' : '配套技能'}</span>
								</li>
							))}
						</ul>
					</div>
				)
			}

			<footer class="article-ending">
				{
					(previousEntry || nextEntry) && (
						<nav class="article-pagination" aria-label="相邻技能">
							{previousEntry && (
								<a
									href={`/vibe-coding/skills/${previousEntry.id}/`}
									class="article-previous"
									rel="prev"
								>
									<span>← 上一个</span>
									<strong class="article-pagination-title">
										{vibeCodingSkillMeta[previousEntry.id]?.chineseName ?? previousEntry.data.name}
									</strong>
								</a>
							)}
							{nextEntry && (
								<a href={`/vibe-coding/skills/${nextEntry.id}/`} class="article-next" rel="next">
									<span>下一个 →</span>
									<strong class="article-pagination-title">
										{vibeCodingSkillMeta[nextEntry.id]?.chineseName ?? nextEntry.data.name}
									</strong>
								</a>
							)}
						</nav>
					)
				}
			</footer>
		</div>
	</article>
	<script is:inline type="module" src="/js/design-gallery.js"></script>
	<script is:inline type="module" src="/js/vibe-coding-skills.js"></script>
</BaseLayout>

<script>
	import '../../../scripts/article-outline.ts';
</script>
