---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { loadDirectoryData } from '../../../lib/directories';
import { vibeCodingSkillCategories } from '../../../data/vibeCodingSkills';

const data = await loadDirectoryData();
const skills = data.index.items.filter((item) => item.section === 'vibe-coding-skills');
const split = (title: string) => {
	const match = /^(.+?)（(.+)）$/.exec(title);
	return match ? { name: match[1], latin: match[2] } : { name: title, latin: '' };
};
const groups = vibeCodingSkillCategories
	.map((category) => ({
		...category,
		skills: skills.filter((item) => item.tags.includes(category.label)),
	}))
	.filter((group) => group.skills.length);
---

<BaseLayout
	title="Skills · Vibe Coding · Bubble's Brain"
	description="浏览原始 SKILL.md、作者和来源，把好方法带进工作流。"
>
	<div class="rr-page rr-page--wide" data-reading-directory>
		<header class="rr-head">
			<nav class="rr-crumbs" aria-label="位置"><a href="/vibe-coding/">Vibe Coding</a> / Skills</nav>
			<h1 class="rr-title" lang="en">Skills</h1>
			<label class="rr-search">
				<i class="ph ph-magnifying-glass" aria-hidden="true"></i>
				<span class="sr-only">搜索 Skills</span>
				<input
					type="search"
					placeholder="搜索 Skills"
					autocomplete="off"
					data-reading-search
				/>
			</label>
			<div class="rr-filters" role="group" aria-label="按分类">
				<button type="button" data-reading-filter="" aria-pressed="true">全部</button>
				{
					groups.map((group) => (
						<button type="button" data-reading-filter={group.id} aria-pressed="false">
							{group.label}
						</button>
					))
				}
			</div>
		</header>

		{
			groups.map((group) => (
				<section
					class="rr-block"
					id={group.id}
					data-reading-group={group.id}
					aria-labelledby={`skills-${group.id}`}
				>
					<div class="rr-block__head">
						<h2 class="rr-block__title" id={`skills-${group.id}`}>
							{group.label}
						</h2>
						<p class="rr-block__lede">{group.description}</p>
					</div>
					<ul class="rr-names rr-names--three">
						{group.skills.map((item) => {
							const { name, latin } = split(item.title);
							return (
								<li data-reading-item data-search={item.title.toLocaleLowerCase()}>
									<a class="rr-name" href={item.href}>
										<span class="rr-name__main">{name}</span>
										{latin && (
											<span class="rr-name__sub" lang="en">
												{latin}
											</span>
										)}
									</a>
								</li>
							);
						})}
					</ul>
				</section>
			))
		}
		<p class="rr-empty" data-reading-empty hidden>没有找到匹配的 Skill，换个词试试。</p>
	</div>
</BaseLayout>

<script>
	import '../../../scripts/readingDirectory';
</script>
