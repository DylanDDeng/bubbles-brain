---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import VibeSiblings from '../../../components/VibeSiblings.astro';
import { vibeCodingTermCategories } from '../../../data/vibeCodingTerms';
import '../../../styles/directories.css';

const total = vibeCodingTermCategories.reduce((sum, category) => sum + category.terms.length, 0);
// AI first: it is what most readers come here for.
const categories = [...vibeCodingTermCategories].sort(
	(a, b) => Number(b.id === 'ai-agent') - Number(a.id === 'ai-agent'),
);
---

<BaseLayout
	title="术语 · Vibe Coding · Bubble's Brain"
	description="图解、比喻，还有可以亲手操作的小实验。把 AI 编程的概念一块一块拆开。"
>
	<div class="rr-page">
		<header class="rr-head">
			<div class="rr-head__text">
				<nav class="rr-crumbs" aria-label="位置"><a href="/vibe-coding/">Vibe Coding</a> / 术语</nav>
				<h1 class="rr-title">术语<span class="rr-title__latin" lang="en">Glossary</span></h1>
				<p class="rr-lede">图解、比喻，还有可以亲手操作的小实验。把 AI 编程的概念一块一块拆开。</p>
				<span class="meta-line">{total} 条 · {categories.length} 类</span>
			</div>
			<VibeSiblings current="terms" />
		</header>

		{
			categories.map((category) => (
				<section class="rr-split" id={category.id} aria-labelledby={`terms-${category.id}`}>
					<div class="rr-split__label">
						<h2 id={`terms-${category.id}`}>
							<a href={`/vibe-coding/terms/${category.id}/`} class="dir-heading-link">
								{category.label}
							</a>
						</h2>
						<span class="rr-count">{category.terms.length} 条</span>
						<p>{category.description}</p>
					</div>
					<ul class="dir-terms">
						{category.terms.map((term) => (
							<li>
								<a class="dir-term" href={`/vibe-coding/terms/${term.id}/`}>
									<span class="dir-term__name">{term.chineseName}</span>
									{term.name !== term.chineseName && (
										<span class="dir-term__latin" lang="en">
											{term.name}
										</span>
									)}
								</a>
							</li>
						))}
					</ul>
				</section>
			))
		}
	</div>
</BaseLayout>
