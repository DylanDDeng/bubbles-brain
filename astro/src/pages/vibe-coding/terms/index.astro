---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { vibeCodingTermCategories } from '../../../data/vibeCodingTerms';

const total = vibeCodingTermCategories.reduce((sum, category) => sum + category.terms.length, 0);
// AI first: it is what most readers come here for.
const categories = [...vibeCodingTermCategories].sort(
	(a, b) => Number(b.id === 'ai-agent') - Number(a.id === 'ai-agent'),
);
---

<BaseLayout
	title="术语 · Vibe Coding · Bubble's Brain"
	description="图解、比喻，还有可以亲手操作的小实验。把 AI 编程的概念一块一块拆开。"
>
	<div class="rr-page rr-page--wide" data-reading-directory>
		<header class="rr-head">
			<nav class="rr-crumbs" aria-label="位置"><a href="/vibe-coding/">Vibe Coding</a> / 术语</nav>
			<h1 class="rr-title">术语</h1>
			<p class="rr-lede">{total} 个词，每个都有图解，有的还能亲手试。</p>
			<label class="rr-search">
				<i class="ph ph-magnifying-glass" aria-hidden="true"></i>
				<span class="sr-only">查术语</span>
				<input type="search" placeholder="查一个词，中英文都行" autocomplete="off" data-reading-search />
			</label>
			<div class="rr-filters" role="group" aria-label="按分类">
				<button type="button" data-reading-filter="" aria-pressed="true">全部</button>
				{
					categories.map((category) => (
						<button type="button" data-reading-filter={category.id} aria-pressed="false">
							{category.label} <span class="rr-count">{category.terms.length}</span>
						</button>
					))
				}
			</div>
		</header>

		{
			categories.map((category) => (
				<section
					class="rr-block"
					id={category.id}
					data-reading-group={category.id}
					aria-labelledby={`terms-${category.id}`}
				>
					<div class="rr-block__head">
						<h2 class="rr-block__title" id={`terms-${category.id}`}>
							<a href={`/vibe-coding/terms/${category.id}/`}>{category.label}</a>
							<span class="rr-count" data-reading-count>
								{category.terms.length}
							</span>
						</h2>
						<p class="rr-block__lede">{category.description}</p>
					</div>
					<ul class="rr-names">
						{category.terms.map((term) => (
							<li
								data-reading-item
								data-search={`${term.chineseName} ${term.name}`.toLocaleLowerCase()}
							>
								<a class="rr-name" href={`/vibe-coding/terms/${term.id}/`}>
									<span class="rr-name__main">{term.chineseName}</span>
									{term.name !== term.chineseName && (
										<span class="rr-name__sub" lang="en">
											{term.name}
										</span>
									)}
								</a>
							</li>
						))}
					</ul>
				</section>
			))
		}
		<p class="rr-empty" data-reading-empty hidden>没有这个词。换个说法，或者用页眉的搜索找找全站。</p>
	</div>
</BaseLayout>

<script>
	import '../../../scripts/readingDirectory';
</script>
