---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { vibeCodingTermCategories, type VibeCodingTerm } from '../../../data/vibeCodingTerms';
import '../../../styles/terms-directory.css';

// AI first: it is what most readers come here for.
const categories = [...vibeCodingTermCategories].sort(
	(a, b) => Number(b.id === 'ai-agent') - Number(a.id === 'ai-agent'),
);
// A large category is read in its groups (界面图鉴: 布局骨架, 输入控件 …); the rest stay one list.
const groupsOf = (terms: VibeCodingTerm[]) => {
	const groups: { label: string | null; terms: VibeCodingTerm[] }[] = [];
	for (const term of terms) {
		const label = term.group ?? null;
		let group = groups.find((item) => item.label === label);
		if (!group) {
			group = { label, terms: [] };
			groups.push(group);
		}
		group.terms.push(term);
	}
	return groups;
};
---

<BaseLayout
	title="术语 · Vibe Coding · Bubble's Brain"
	description="图解、比喻，还有可以亲手操作的小实验。把 AI 编程的概念一块一块拆开。"
>
	<div class="terms-page" data-terms-directory>
		<header class="rr-head">
			<nav class="rr-crumbs" aria-label="位置"><a href="/vibe-coding/">Vibe Coding</a> / 术语</nav>
			<h1 class="rr-title">术语</h1>
			<label class="rr-search">
				<i class="ph ph-magnifying-glass" aria-hidden="true"></i>
				<span class="sr-only">查术语</span>
				<input type="search" placeholder="查一个词，中英文都行" autocomplete="off" data-terms-search />
			</label>
		</header>

		<div class="terms-body">
			<nav class="terms-rail" aria-label="术语分类">
				{
					categories.map((category) => (
						<a href={`#${category.id}`} data-terms-tab={category.id}>
							{category.label}
						</a>
					))
				}
			</nav>

			<div class="terms-main">
				{
					categories.map((category) => (
						<section
							class="terms-category"
							id={category.id}
							data-terms-group={category.id}
							aria-labelledby={`terms-${category.id}`}
						>
							<h2 id={`terms-${category.id}`}>
								<a href={`/vibe-coding/terms/${category.id}/`}>{category.label}</a>
							</h2>
							<p class="terms-category__lede">{category.description}</p>
							{groupsOf(category.terms).map((group) => (
								<div class="terms-group" data-terms-sub>
									{group.label && <h3>{group.label}</h3>}
									<ul class="rr-names rr-names--three">
										{group.terms.map((term) => (
											<li
												data-terms-item
												data-search={`${term.chineseName} ${term.name}`.toLocaleLowerCase()}
											>
												<a class="rr-name" href={`/vibe-coding/terms/${term.id}/`}>
													<span class="rr-name__main">{term.chineseName}</span>
													{term.name !== term.chineseName && (
														<span class="rr-name__sub" lang="en">
															{term.name}
														</span>
													)}
												</a>
											</li>
										))}
									</ul>
								</div>
							))}
						</section>
					))
				}
				<p class="rr-empty" data-terms-empty hidden>
					没有这个词。换个说法，或者用页眉的搜索找找全站。
				</p>
			</div>
		</div>
	</div>
</BaseLayout>

<script>
	import '../../../scripts/termsDirectory';
</script>
