{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bubblenews.today/schemas/benchmarks.schema.json",
  "title": "Model benchmark ledger",
  "description": "Hand-curated benchmark scores rendered at /benchmarks/. Model ids follow Artificial Analysis naming.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "checked_at", "benchmarks", "models"],
  "definitions": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "bilingual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zh", "en"],
      "properties": {
        "zh": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "source",
        "url",
        "format",
        "measures",
        "explainer",
        "description"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/slug" },
        "name": { "$ref": "#/definitions/bilingual" },
        "source": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://" },
        "format": { "enum": ["integer", "percent"] },
        "measures": {
          "description": "One line: which capability this benchmark tests.",
          "$ref": "#/definitions/bilingual"
        },
        "explainer": {
          "description": "A short paragraph for readers who have never heard of the benchmark.",
          "$ref": "#/definitions/bilingual"
        },
        "description": {
          "description": "How to read the number.",
          "$ref": "#/definitions/bilingual"
        }
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": { "type": "number", "minimum": 0 },
        "ci": { "type": "number", "exclusiveMinimum": 0 },
        "agent": { "type": "string", "minLength": 1 },
        "note": { "$ref": "#/definitions/bilingual" },
        "note_url": { "type": "string", "pattern": "^https://" }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "creator", "scores"],
      "properties": {
        "id": { "$ref": "#/definitions/slug" },
        "name": { "type": "string", "minLength": 1 },
        "creator": { "type": "string", "minLength": 1 },
        "scores": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/definitions/slug" },
          "additionalProperties": { "$ref": "#/definitions/score" }
        }
      }
    }
  },
  "properties": {
    "schema_version": { "const": 1 },
    "checked_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "benchmarks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/benchmark" }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/model" }
    }
  }
}
